@using MyPortfolio.Models.ManagerModels.RoleModels
@model CreateEditRoleViewModel
@{
    Layout = "_AdminLayout";
    var roleId = ViewContext.RouteData.Values["id"] as string ?? string.Empty;

    ViewData["Title"] = "Edit role";
    ViewData["PageKicker"] = "Roles";
    ViewData["PageTitle"] = "Edit role";
    ViewData["PageDesc"] = string.IsNullOrWhiteSpace(Model.RoleName)
        ? "Rename this role."
        : Model.RoleName;
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
    @if (!string.IsNullOrWhiteSpace(roleId))
    {
        <a class="btn btn--soft" asp-action="Details" asp-route-id="@roleId">
            <ui-icon name="eye" size="sm" />
            <span class="btn__label">Details</span>
        </a>
    }
}

<section class="card max-w-md">
    <div class="card__bd">
        <form asp-action="Edit" asp-route-id="@roleId" method="post" novalidate class="form-grid">
            <div asp-validation-summary="ModelOnly"></div>

            <partial name="RolePartialViews/CreateEditRolePartialView" model="Model" />

            <div class="form-foot">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="save" size="sm" />
                    <span class="btn__label">Save changes</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
