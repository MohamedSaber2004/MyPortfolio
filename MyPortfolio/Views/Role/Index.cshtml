@using MyPortfolio.Models.ManagerModels.RoleModels
@model IEnumerable<RoleViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Roles";
    ViewData["PageKicker"] = "Access";
    ViewData["PageTitle"] = "Roles";
    ViewData["PageDesc"] = "The role names accounts are tagged with, and the admin area they unlock.";

    var rows = Model?.ToList() ?? [];
    var live = rows.Count(r => !r.IsDeleted);
}

@section PageActions {
    <a class="btn btn--primary" asp-action="Create">
        <ui-icon name="plus" size="sm" />
        <span class="btn__label">New role</span>
    </a>
}

<form class="toolbar" asp-action="Index" method="get" autocomplete="off" data-search="#roleTable">
    <span class="input-wrap grow">
        <span class="input-wrap__icon"><ui-icon name="search" size="sm" /></span>
        <label class="sr-only" for="roleSearchName">Search roles</label>
        <input class="input" id="roleSearchName" name="RoleSearchName" type="search"
               value="@Context.Request.Query["RoleSearchName"]" placeholder="Role name…" />
    </span>
    <button class="btn btn--soft" type="submit">
        <ui-icon name="search" size="sm" />
        <span class="btn__label">Search</span>
    </button>
    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["RoleSearchName"]))
    {
        <a class="btn btn--quiet" asp-action="Index">Clear</a>
    }
</form>

<div id="roleTable">
    @if (rows.Count == 0)
    {
        <div class="card">
            <partial name="_EmptyState" model="@(new EmptyStateVm {
                Title = "No roles match",
                Text = "Nothing can be granted until at least one role exists.",
                Icon = "shield",
                ActionHref = Url.Action("Create", "Role"),
                ActionLabel = "Add the first role" })" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack table--sticky">
                <caption class="sr-only">Roles, in the order they were stored</caption>
                <thead>
                    <tr>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="table__num">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in rows)
                    {
                        <tr data-deleted="@(role.IsDeleted ? "true" : "false")">
                            <td data-label="Role">
                                <div class="table__main flex gap-3 items-center">
                                    <span class="tile tile--accent" aria-hidden="true">
                                        <ui-icon name="shield" size="sm" />
                                    </span>
                                    <a class="table__primary" asp-action="Details" asp-route-id="@role.Id">@role.RoleName</a>
                                </div>
                            </td>
                            <td data-label="Status">
                                <span class="badge badge--@(role.IsDeleted ? "danger" : "success")">
                                    @(role.IsDeleted ? "Archived" : "Live")
                                </span>
                            </td>
                            <td data-label="Actions">
                                <div class="table__actions">
                                    <a class="btn btn--icon btn--quiet" asp-action="Details" asp-route-id="@role.Id"
                                       data-tip="Details" aria-label="@($"Details for {role.RoleName}")">
                                        <ui-icon name="eye" size="sm" />
                                    </a>
                                    <a class="btn btn--icon btn--quiet" asp-action="Edit" asp-route-id="@role.Id"
                                       data-tip="Edit" aria-label="@($"Edit {role.RoleName}")">
                                        <ui-icon name="edit" size="sm" />
                                    </a>
                                    @if (role.IsDeleted)
                                    {
                                        <form asp-action="Restore" asp-route-id="@role.Id" method="post"
                                              data-confirm-title="Restore role"
                                              data-confirm="@($"Put {role.RoleName} back in the picker?")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--success" type="submit"
                                                    data-tip="Restore" aria-label="@($"Restore {role.RoleName}")">
                                                <ui-icon name="restore" size="sm" />
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-route-id="@role.Id" method="post"
                                              data-confirm-title="Archive role"
                                              data-confirm="@($"{role.RoleName} stops appearing in the role pickers. Accounts keep the tag until you remove it.")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--danger" type="submit"
                                                    data-tip="Delete" aria-label="@($"Delete {role.RoleName}")">
                                                <ui-icon name="del" size="sm" />
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="meta mt-3">
            <span class="meta__item">@live live</span>
            <span class="meta__item">@(rows.Count - live) archived</span>
        </p>
    }
</div>
