@using MyPortfolio.Models.ManagerModels.RoleModels
@model RoleViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.RoleName;
    ViewData["PageKicker"] = "Role";
    ViewData["PageTitle"] = string.IsNullOrWhiteSpace(Model.RoleName) ? "Role" : Model.RoleName;
    ViewData["PageDesc"] = Model.IsDeleted ? "Archived access group." : "Active access group.";
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">All roles</a>
    <a class="btn btn--primary" asp-action="Edit" asp-route-id="@Model.Id">
        <ui-icon name="edit" size="sm" />
        <span class="btn__label">Edit</span>
    </a>
}

<div class="dash-grid dash-grid--split">
    <section class="card">
        <h2 class="sr-only">Role details</h2>
        <dl class="dl">
            <div class="dl__row">
                <dt>Status</dt>
                <dd>
                    <span class="badge badge--@(Model.IsDeleted ? "danger" : "success")">
                        @(Model.IsDeleted ? "Archived" : "Live")
                    </span>
                </dd>
            </div>
            <div class="dl__row">
                <dt>Role name</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.RoleName) ? "—" : Model.RoleName)</dd>
            </div>
            <div class="dl__row">
                <dt>Record</dt>
                <dd class="mono break-any">@Model.Id</dd>
            </div>
        </dl>
    </section>

    <div class="dash-grid">
        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Members</h2>
                <ui-icon name="key" size="sm" />
            </header>
            <p class="text-sm text-muted mb-3">This role is handed out one account at a time in the user editor.</p>
            <a class="btn btn--soft" asp-controller="User" asp-action="Index">
                <ui-icon name="users" size="sm" />
                <span class="btn__label">Open users</span>
            </a>
        </section>

        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Danger zone</h2>
            </header>
            @if (Model.IsDeleted)
            {
                <form asp-action="Restore" asp-route-id="@Model.Id" method="post"
                      data-confirm-title="Restore role"
                      data-confirm="@($"Put {Model.RoleName} back in the pickers?")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--success btn--block" type="submit">
                        <ui-icon name="restore" size="sm" />
                        <span class="btn__label">Restore this role</span>
                    </button>
                </form>
            }
            else
            {
                <p class="text-sm text-muted mb-3">Archiving hides the role from the pickers. Accounts already tagged with it keep the tag.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      data-confirm-title="Archive role"
                      data-confirm="@($"{Model.RoleName} stops appearing in the role pickers. You can restore it later.")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--danger btn--block" type="submit">
                        <ui-icon name="del" size="sm" />
                        <span class="btn__label">Archive this role</span>
                    </button>
                </form>
            }
        </section>
    </div>
</div>
