@using MyPortfolio.Models.ManagerModels.RoleModels
@model CreateEditRoleViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "New role";
    ViewData["PageKicker"] = "Roles";
    ViewData["PageTitle"] = "Add a role";
    ViewData["PageDesc"] = "It becomes selectable in the user editor as soon as you save.";
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
}

<section class="card max-w-md">
    <div class="card__bd">
        <form asp-action="Create" method="post" novalidate class="form-grid">
            <div asp-validation-summary="ModelOnly"></div>

            <partial name="RolePartialViews/CreateEditRolePartialView" model="Model" />

            <div class="form-foot">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="check" size="sm" />
                    <span class="btn__label">Create role</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
