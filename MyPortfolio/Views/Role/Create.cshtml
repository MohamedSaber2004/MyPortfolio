@using MyPortfolio.Models.ManagerModels.RoleModels
@model CreateEditRoleViewModel
@{
    ViewData["Title"] = "Create Role";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="main-content">
    <div class="page-header mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="page-title">Create Role</h1>
            <p class="page-subtitle">Add a new role to the system.</p>
        </div>
        <a asp-controller="Role" asp-action="Index" class="btn btn-ghost">
            <i class="bi bi-arrow-left"></i> Back to list
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 fade-in">
                <div class="card-body">
                    <form method="post" asp-controller="Role" asp-action="Create" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <partial name="RolePartialViews/CreateEditRolePartialView" model="Model" />

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Save
                            </button>
                            <a asp-controller="Role" asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
