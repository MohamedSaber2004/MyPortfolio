@using MyPortfolio.Models.ManagerModels.RoleModels
@model CreateEditRoleViewModel

@* Shared by Role/Create and Role/Edit: a picker when candidates exist, a free-text name otherwise. *@
<div class="field">
    <label asp-for="RoleName" class="field__label"></label>

    @if (Model?.AvailableRoles?.Any() == true)
    {
        <select asp-for="RoleName" class="select" asp-items="Model.AvailableRoles">
            <option value="">Select role</option>
        </select>
        <span class="field__hint">Pick the role you want to rename.</span>
    }
    else
    {
        <input asp-for="RoleName" class="input" placeholder="e.g. Editor" autocomplete="off" />
        <span class="field__hint">Exact text the authorisation attributes match against.</span>
    }

    <span asp-validation-for="RoleName"></span>
</div>
