<!-- Project Details Modal -->
<div class="modal fade" id="projectDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="pdDescription" class="text-muted mb-3"></p>
                <div class="d-flex flex-wrap gap-2 mb-3" id="pdTags"></div>
                <div class="d-flex gap-2 flex-wrap" id="pdLinks"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            const cls = 'btn-copy-contact';
            document.addEventListener('click', async e => {
                const btn = e.target.closest('.' + cls);
                if(!btn) return;
                const originalHtml = btn.innerHTML;
                const text = btn.getAttribute('data-copy');
                try {
                    await navigator.clipboard.writeText(text);
                    btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                    btn.classList.add('copied');
                    setTimeout(()=> {
                        btn.innerHTML = originalHtml;
                        btn.classList.remove('copied');
                    }, 1600);
                } catch {
                    btn.innerHTML = '<i class="bi bi-exclamation-triangle"></i>';
                    setTimeout(()=> btn.innerHTML = originalHtml, 1600);
                }
            }, { passive: true });
        })();

        (function(){
            document.addEventListener('click', function(e) {
                var btn = e.target.closest('.toggle-btn');
                if (!btn) return;
                var container = btn.closest('.read-more-container');
                if (!container) return;
                var hidden = container.querySelector('.hidden-items');
                if (!hidden) return;
                var isOpen = hidden.classList.toggle('open');
                var textSpan = btn.querySelector('.toggle-text');
                if (textSpan) textSpan.textContent = isOpen ? 'Show Less' : 'Show More';
                if (isOpen && btn.scrollIntoView) {
                    setTimeout(function() {
                        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }, 150);
                }
            });

            document.addEventListener('click', function(e) {
                var btn = e.target.closest('.btn-project-details');
                if (!btn) return;
                var card = btn.closest('.project-card');
                if (!card) return;
                document.getElementById('pdTitle').textContent = card.getAttribute('data-pd-title');
                document.getElementById('pdDescription').textContent = card.getAttribute('data-pd-desc');
                var tagsStr = card.getAttribute('data-pd-tags');
                var tagsEl = document.getElementById('pdTags');
                tagsEl.innerHTML = '';
                if (tagsStr) {
                    tagsStr.split(',').forEach(function(t) {
                        var span = document.createElement('span');
                        span.className = 'badge rounded-pill bg-info-subtle text-info-emphasis small';
                        span.textContent = t.trim();
                        tagsEl.appendChild(span);
                    });
                }
                var linksEl = document.getElementById('pdLinks');
                linksEl.innerHTML = '';
                ['pd-site','pd-repo','pd-demo'].forEach(function(k) {
                    var url = card.getAttribute('data-' + k);
                    if (!url) return;
                    var a = document.createElement('a');
                    a.href = url;
                    a.target = '_blank';
                    a.rel = 'noopener';
                    var label = k.replace('pd-','');
                    a.className = 'btn btn-xs ' + (label === 'demo' ? 'btn-primary' : 'btn-outline-primary') + ' fw-semibold';
                    a.textContent = label.charAt(0).toUpperCase() + label.slice(1);
                    linksEl.appendChild(a);
                });
                var modal = new bootstrap.Modal(document.getElementById('projectDetailsModal'));
                modal.show();
            });

            const scrollBtn = document.getElementById('scrollTopBtn');
            window.addEventListener('scroll', () => {
                scrollBtn.classList.toggle('visible', window.scrollY > 400);
            }, {passive:true});

            const revealEls = document.querySelectorAll('.section-block, .portfolio-card, .edu-card');
            const io = new IntersectionObserver((entries) => {
                entries.forEach(e => {
                    if(e.isIntersecting){
                        e.target.classList.add('visible');
                        e.target.style.opacity = '1';
                        e.target.style.transform = 'translateY(0)';
                    }
                });
            }, {threshold: 0.1});
            revealEls.forEach(el => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(24px)';
                el.style.transition = 'opacity .7s ease, transform .7s ease';
                io.observe(el);
            });

            const progBars = document.querySelectorAll('.skill-progress .progress-bar');
            const barIO = new IntersectionObserver((entries) => {
                entries.forEach(e => {
                    if(e.isIntersecting){
                        const target = e.target.getAttribute('aria-valuenow') + '%';
                        e.target.style.width = target;
                        barIO.unobserve(e.target);
                    }
                });
            }, {threshold: 0.3});
            progBars.forEach(b => { b.style.width = '0'; barIO.observe(b); });

            const navbar = document.querySelector('.main-navbar');
            if(navbar){
                window.addEventListener('scroll', () => {
                    navbar.classList.toggle('scrolled', window.scrollY > 60);
                }, {passive:true});
            }
        })();
    </script>
}
