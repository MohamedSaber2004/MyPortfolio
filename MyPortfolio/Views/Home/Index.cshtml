@using MyPortfolio.Models.Home
@using DataAccessLayer.Models.Shared.Enums
@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["MetaDescription"] = "Mohamed Saber — full stack .NET developer. Projects, experience, education and skills, presented as a single-page portfolio.";

    const string DisplayName = "Mohamed Saber Ahmed Ali";

    string Month(DateOnly value) => Display.Month(value);

    string LevelBadge(ProficiencyLevels level) => level switch
    {
        ProficiencyLevels.Advanced => "badge badge--success badge--pill",
        ProficiencyLevels.Intermmediate => "badge badge--info badge--pill",
        _ => "badge badge--pill"
    };

    string SocialIcon(string? platform)
    {
        return (platform ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "github" => "github",
            "linkedin" => "linkedin",
            "twitter" or "x" => "twitter",
            "youtube" => "youtube",
            "instagram" => "instagram",
            "facebook" => "facebook",
            "stackoverflow" or "stack overflow" => "stackoverflow",
            "medium" => "medium",
            "discord" => "discord",
            "gitlab" => "gitlab",
            "dev" or "dev.to" => "devto",
            "whatsapp" => "whatsapp",
            "telegram" => "telegram",
            "twitch" => "twitch",
            _ => "link45"
        };
    }

    string ContactIcon(string? type)
    {
        return (type ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "email" or "mail" => "mail",
            "phone" or "mobile" or "tel" => "phone",
            "whatsapp" => "whatsapp",
            "telegram" => "telegram",
            "location" or "address" => "location",
            "website" or "site" or "url" => "web",
            "portfolio" => "grid",
            "linkedin" => "linkedin",
            "github" => "github",
            _ => "chat"
        };
    }

    (bool IsLink, string? Href, bool External) ContactLink(string? type, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return (false, null, false);
        var kind = (type ?? string.Empty).Trim().ToLowerInvariant();
        var raw = value.Trim();

        if (kind is "email" or "mail")
            return (true, raw.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase) ? raw : $"mailto:{raw}", false);

        if (kind is "phone" or "mobile" or "tel")
            return (true, "tel:" + new string(raw.Where(ch => char.IsDigit(ch) || ch == '+').ToArray()), false);

        if (kind is "whatsapp")
        {
            var digits = new string(raw.Where(ch => char.IsDigit(ch) || ch == '+').ToArray()).TrimStart('+');
            return digits.Length == 0 ? (false, null, false) : (true, $"https://wa.me/{digits}", true);
        }

        if (Uri.TryCreate(raw, UriKind.Absolute, out var absolute))
            return (true, absolute.ToString(), true);

        if (raw.StartsWith("www.", StringComparison.OrdinalIgnoreCase))
            return (true, $"https://{raw}", true);

        return (false, null, false);
    }

    string ProjectImage(string? file)
        => string.IsNullOrWhiteSpace(file)
            ? string.Empty
            : $"/Files/Images/Projects/{Uri.EscapeDataString(file.Trim())}";

    var skills = Model.Skills;
    var experiences = Model.Experiences ?? [];
    var projects = Model.Projects ?? [];
    var educations = Model.Educations ?? [];
    var socialLinks = Model.SocialLinks ?? [];
    var contacts = Model.Contacts ?? [];
    var cvHref = $"/Files/{Model.CvFileName ?? "CV.pdf"}";
    var totalMonths = experiences.Sum(entry => Display.Months(entry.StartDate, entry.EndDate));
    var timeLabel = totalMonths >= 12 ? $"{totalMonths / 12}+ yrs" : $"{totalMonths} mo";
}

<section class="hero" id="top">
    <div class="container hero__inner">
        <div>
            <span class="hero__kicker">
                <span class="dot dot--live text-success" aria-hidden="true"></span>
                Open to new opportunities
            </span>
            <h1 class="hero__title">Mohamed&nbsp;<em>Saber</em></h1>
            <p class="hero__lede">
                Full stack developer working the whole path — from a schema that holds up to an
                interface that feels light. C#, ASP.NET Core, and a design system written by hand.
            </p>

            <div class="hero__actions">
                <a class="btn btn--primary" href="#projects">
                    <ui-icon name="projects" size="sm" /> See the work
                </a>
                <a class="btn btn--outline" href="#contact">
                    <ui-icon name="mail" size="sm" /> Get in touch
                </a>
                <a class="btn btn--ghost" href="@cvHref" target="_blank" rel="noopener">
                    <ui-icon name="download" size="sm" /> Résumé
                </a>
            </div>

            <dl class="hero__facts">
                <div>
                    <dd class="fact__value tabular" data-count="@projects.Count" data-suffix="+">@projects.Count+</dd>
                    <dt class="fact__label">Shipped projects</dt>
                </div>
                <div>
                    <dd class="fact__value tabular" data-count="@skills.Count" data-suffix="+">@skills.Count+</dd>
                    <dt class="fact__label">Technologies</dt>
                </div>
                <div>
                    <dd class="fact__value">@timeLabel</dd>
                    <dt class="fact__label">On the job</dt>
                </div>
            </dl>

            <a class="scroll-cue" href="#about" aria-label="Go to the about section">
                <span class="scroll-cue__track" aria-hidden="true"><span class="scroll-cue__wheel"></span></span>
                Scroll
            </a>
        </div>

        @if (Model.PortraitUrl is not null)
        {
            <figure class="portrait" data-reveal>
                <img src="@Model.PortraitUrl" alt="Portrait of @DisplayName" width="480" height="600"
                     fetchpriority="high" decoding="async" />
                <figcaption class="portrait__badge">
                    <ui-icon name="code" size="sm" /> Full stack · .NET
                </figcaption>
            </figure>
        }
    </div>
</section>

<section class="section" id="about">
    <div class="container container--read">
        <header class="section-head" data-reveal>
            <span class="section-head__num">01</span>
            <h2 class="section-head__title">About</h2>
            <p class="section-head__sub">How I work, and what I optimise for.</p>
        </header>

        <p class="about-lead" data-reveal>
            I build systems that stay understandable: layered where the domain demands it, plain
            where it does not. Backend in C# and EF Core, front end kept close to the metal —
            tokens, components and motion instead of a framework's opinions.
        </p>
        <p class="text-muted" data-reveal>
            Most of my work is on dashboards and data-driven applications: clean architecture, a
            repository and unit-of-work layer over SQL Server, Identity with roles, and an admin
            surface people actually open every day. I care about contrast, keyboard paths and the
            first paint.
        </p>

    </div>
</section>

<section class="section section--sunken" id="skills">
    <div class="container">
        <header class="section-head" data-reveal>
            <span class="section-head__num">02</span>
            <h2 class="section-head__title">Skills</h2>
            <p class="section-head__sub">What I reach for, and how deep it goes.</p>
        </header>

        @if (skills.Count > 0)
        {
            <div class="grid cols-2-md cols-3-lg cols-4-xl gap-4" data-fold="8" data-stagger>
                @foreach (var skill in skills)
                {
                    var percent = Display.LevelPercent(skill.ProficiencyLevel);
                    <div class="card skill-card" data-fold-item>
                        <div class="skill-card__top">
                            <span class="tile" aria-hidden="true"><ui-icon name="skill" size="sm" /></span>
                            <div class="min-w-0 grow">
                                <div class="skill-card__name truncate" title="@skill.SkillName">@skill.SkillName</div>
                                <div class="text-xs text-muted">@Display.Level(skill.ProficiencyLevel)</div>
                            </div>
                        </div>
                        <div class="progress" role="progressbar" aria-label="@skill.SkillName proficiency"
                             aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress__bar" style="--value:@percent%;" data-bar data-value="@percent"></div>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="@LevelBadge(skill.ProficiencyLevel) tabular">@percent%</span>
                            @if (skill.IsDeleted)
                            {
                                <span class="text-danger text-xs fw-600">Retired</span>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="flex justify-center mt-6">
                <button class="btn btn--outline btn--sm" type="button" data-fold-toggle hidden
                        data-label-more="Show all skills" data-label-less="Show fewer">
                    <span data-fold-label>Show all skills</span>
                    <ui-icon name="chevD" size="sm" />
                </button>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyStateVm { Title = "No skills published yet", Text = "Add technologies in the admin panel and they appear here.", Icon = "skill" })" />
        }
    </div>
</section>

<section class="section" id="experience">
    <div class="container container--read">
        <header class="section-head" data-reveal>
            <span class="section-head__num">03</span>
            <h2 class="section-head__title">Experience</h2>
            <p class="section-head__sub">Teams, products and what each one taught me.</p>
        </header>

        @if (experiences.Count > 0)
        {
            <div class="timeline" data-fold="4">
                @foreach (var item in experiences)
                {
                    <article class="timeline__item" data-fold-item>
                        <header class="flex items-baseline justify-between gap-3 wrap">
                            <h3 class="card__title">@item.Role</h3>
                            <span class="timeline__when">@Month(item.StartDate) — @Month(item.EndDate)</span>
                        </header>
                        <p class="text-muted text-sm mb-2">
                            @item.CompanyName <span class="text-faint">· @Display.Tenure(item.StartDate, item.EndDate)</span>
                            @if (item.IsDeleted)
                            {
                                <span class="badge badge--danger badge--pill ms-2">Archived</span>
                            }
                        </p>
                        @foreach (var line in DescriptionLines(item.Description))
                        {
                            <p class="text-sm lh-normal mb-2">@line</p>
                        }
                    </article>
                }
            </div>
            <div class="flex justify-center mt-6">
                <button class="btn btn--outline btn--sm" type="button" data-fold-toggle hidden
                        data-label-more="Show earlier roles" data-label-less="Show fewer">
                    <span data-fold-label>Show earlier roles</span>
                    <ui-icon name="chevD" size="sm" />
                </button>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyStateVm { Title = "No experience listed", Text = "Roles appear here once they are added in the admin panel.", Icon = "briefcase" })" />
        }
    </div>
</section>

<section class="section section--sunken" id="education">
    <div class="container">
        <header class="section-head" data-reveal>
            <span class="section-head__num">04</span>
            <h2 class="section-head__title">Education</h2>
            <p class="section-head__sub">Where the fundamentals came from.</p>
        </header>

        @if (educations.Count > 0)
        {
            <div class="grid cols-2-md cols-3-lg gap-4" data-fold="3" data-stagger>
                @foreach (var entry in educations)
                {
                    <article class="card card--accent" data-fold-item>
                        <div class="card__bd">
                            <span class="timeline__when">@Month(entry.StartDate) — @Month(entry.EndDate)</span>
                            <h3 class="card__title mt-2">@entry.Degree</h3>
                            <p class="text-muted text-sm mb-3">@entry.InstitutionName</p>
                            <span class="badge badge--info badge--pill">@entry.FieldOfStudy</span>
                            @foreach (var line in DescriptionLines(entry.Description))
                            {
                                <p class="text-sm text-muted lh-normal mb-2">@line</p>
                            }
                            @if (entry.IsDeleted)
                            {
                                <span class="badge badge--danger badge--pill mt-2">Archived</span>
                            }
                        </div>
                    </article>
                }
            </div>
            <div class="flex justify-center mt-6">
                <button class="btn btn--outline btn--sm" type="button" data-fold-toggle hidden
                        data-label-more="Show all education" data-label-less="Show fewer">
                    <span data-fold-label>Show all education</span>
                    <ui-icon name="chevD" size="sm" />
                </button>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyStateVm { Title = "No education records", Icon = "cap" })" />
        }
    </div>
</section>

<section class="section" id="projects">
    <div class="container">
        <header class="section-head" data-reveal>
            <span class="section-head__num">05</span>
            <h2 class="section-head__title">Selected work</h2>
            <p class="section-head__sub">Products built end to end — hover a card for its links.</p>
        </header>

        @if (projects.Count > 0)
        {
            <div class="grid cols-2-md cols-3-lg gap-4" data-fold="6" data-stagger>
                @foreach (var project in projects)
                {
                    var image = ProjectImage(project.ExistingProjectImage);
                    var site = project.ProjectURL?.Trim() ?? string.Empty;
                    <article class="card card--interactive" data-fold-item data-glow>
                        <div class="card__media">
                            @if (image.Length > 0)
                            {
                                <img src="@image" alt="@project.Title" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span class="absolute inset-0 flex items-center justify-center text-faint">
                                    <ui-icon name="folderOpen" size="xl" />
                                </span>
                            }
                        </div>
                        <div class="work-card__body">
                            <h3 class="work-card__title truncate" title="@project.Title">@project.Title</h3>
                            <p class="work-card__desc clamp-3">@project.Description</p>
                            <div class="flex items-center gap-3 text-xs text-faint">
                                <span class="tabular">@Month(project.StartDate) — @Month(project.EndDate)</span>
                                @if (project.IsDeleted)
                                {
                                    <span class="badge badge--danger badge--pill">Archived</span>
                                }
                            </div>
                        </div>
                        <div class="card__glow" aria-hidden="true"></div>
                        <div class="work-card__actions">
                            <p class="text-sm clamp-3">@project.Description</p>
                            <div class="flex gap-2 wrap">
                                <button class="btn btn--sm" type="button"
                                        data-dialog="#projectDialog"
                                        data-puttitle="@project.Title"
                                        data-putdesc="@project.Description"
                                        data-putspan="@Display.Tenure(project.StartDate, project.EndDate)"
                                        data-putsite="@site"
                                        aria-label="Details for @project.Title">
                                    <ui-icon name="eye" size="sm" /> Details
                                </button>
                                @if (site.Length > 0)
                                {
                                    <a class="btn btn--sm btn--primary" href="@site" target="_blank" rel="noopener">
                                        <ui-icon name="external" size="sm" /> Visit
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
            <div class="flex justify-center mt-6">
                <button class="btn btn--outline btn--sm" type="button" data-fold-toggle hidden
                        data-label-more="Show all projects" data-label-less="Show fewer">
                    <span data-fold-label>Show all projects</span>
                    <ui-icon name="chevD" size="sm" />
                </button>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyStateVm { Title = "No projects published yet", Text = "Projects added in the admin panel appear here with their cover image.", Icon = "projects" })" />
        }
    </div>
</section>

<section class="section section--sunken" id="social">
    <div class="container">
        <header class="section-head" data-reveal>
            <span class="section-head__num">06</span>
            <h2 class="section-head__title">Elsewhere</h2>
            <p class="section-head__sub">Where I keep code, notes and conversations.</p>
        </header>

        @if (socialLinks.Count > 0)
        {
            <div class="grid cols-3-sm cols-4-md cols-5-lg gap-4" data-stagger>
                @foreach (var link in socialLinks)
                {
                    var platform = link.PlatformName?.Trim() ?? string.Empty;
                    <a class="card card--interactive" href="@link.URL" target="_blank" rel="noopener"
                       aria-label="@platform (opens in a new tab)">
                        <span class="social-tile" data-platform="@platform.ToLowerInvariant()">
                            <span class="social-tile__icon" aria-hidden="true"><ui-icon name="@SocialIcon(platform)" size="lg" /></span>
                            <span class="social-tile__label truncate">@platform</span>
                        </span>
                    </a>
                }
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyStateVm { Title = "No social links yet", Icon = "share" })" />
        }
    </div>
</section>

<section class="section" id="contact">
    <div class="container">
        <header class="section-head" data-reveal>
            <span class="section-head__num">07</span>
            <h2 class="section-head__title">Contact</h2>
            <p class="section-head__sub">One of these reaches me fastest — copy any value.</p>
        </header>

        @if (contacts.Count > 0)
        {
            <div class="grid cols-2-md cols-3-lg gap-4" data-fold="6" data-stagger>
                @foreach (var entry in contacts)
                {
                    var kind = entry.ContactType?.Trim() ?? string.Empty;
                    var (isLink, href, external) = ContactLink(kind, entry.ContactValue);
                    <div class="card contact-card" data-fold-item>
                        <div class="card__bd flex items-start justify-between gap-3">
                            <span class="tile" aria-hidden="true"><ui-icon name="@ContactIcon(kind)" size="sm" /></span>
                            <button class="btn btn--quiet btn--icon btn--sm contact-card__copy" type="button"
                                    data-copy="@entry.ContactValue" data-copied="false" aria-label="Copy @kind value">
                                <ui-icon name="copy" size="sm" />
                            </button>
                        </div>
                        <div class="card__ft">
                            <p class="eyebrow mb-2">@kind</p>
                            @if (isLink)
                            {
                                <a class="contact-card__value" href="@href"
                                   target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)">
                                    <span>@entry.ContactValue</span>
                                    @if (external)
                                    {
                                        <ui-icon name="external" size="sm" class="text-faint" />
                                    }
                                </a>
                            }
                            else
                            {
                                <span class="contact-card__value">@entry.ContactValue</span>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="flex justify-center mt-6">
                <button class="btn btn--outline btn--sm" type="button" data-fold-toggle hidden
                        data-label-more="Show all channels" data-label-less="Show fewer">
                    <span data-fold-label>Show all channels</span>
                    <ui-icon name="chevD" size="sm" />
                </button>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyStateVm { Title = "No contact details yet", Icon = "mail" })" />
        }
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="cta-band relative overflow-hidden" data-reveal>
            <span class="aura aura--warm aura--a" aria-hidden="true"></span>
            <span class="aura aura--cool aura--b" aria-hidden="true"></span>
            <h2 class="cta-band__title">Have something to build?</h2>
            <p class="text-muted max-w-read m-auto mb-5">
                I take on full stack work in C# and ASP.NET Core — dashboards, APIs and the
                interface on top of them. Tell me what you need and I'll answer honestly.
            </p>
            <div class="flex justify-center gap-3 wrap">
                <a class="btn btn--primary" href="mailto:dev.mohamed104saber@gmail.com">
                    <ui-icon name="send" size="sm" /> Start a conversation
                </a>
                <a class="btn btn--outline" href="@cvHref" target="_blank" rel="noopener">
                    <ui-icon name="pdf" size="sm" /> Full résumé
                </a>
            </div>
        </div>
    </div>
</section>

<dialog class="dialog" id="projectDialog" aria-labelledby="projectDialog-title">
    <div class="dialog__hd">
        <p class="eyebrow eyebrow--accent mb-2">Selected work</p>
        <h2 class="dialog__title" id="projectDialog-title" data-dst="title">Project</h2>
    </div>
    <div class="dialog__bd">
        <p class="dialog__body-text" data-dst="desc"></p>
        <p class="text-xs text-faint tabular mt-3" data-dst="span"></p>
    </div>
    <div class="dialog__ft">
        <a class="btn btn--primary" href="#" target="_blank" rel="noopener" data-dst="site" hidden>
            <ui-icon name="external" size="sm" /> Visit project
        </a>
        <button class="btn btn--ghost" type="button" data-dialog-close>Close</button>
    </div>
</dialog>

@functions {
    static IEnumerable<string> DescriptionLines(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) yield break;
        foreach (var line in text.Replace("\r\n", "\n")
                                 .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            yield return line;
        }
    }
}
