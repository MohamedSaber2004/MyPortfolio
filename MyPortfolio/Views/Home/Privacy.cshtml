@{
    ViewData["Title"] = "Privacy";
    ViewData["MetaDescription"] = "How this portfolio handles the little data it collects: accounts, cookies and sign-in.";
}

<section class="section">
    <div class="container container--read">
        <header class="section-head section-head--start">
            <span class="section-head__num" aria-hidden="true">§</span>
            <h1 class="section-head__title">Privacy note</h1>
            <p class="section-head__sub">Last updated @DateTime.UtcNow.ToString("MMMM yyyy"). Short, because the site stores very little.</p>
        </header>

        <div class="stack gap-5">
            <div class="stack gap-2">
                <h2>What is collected</h2>
                <p class="text-muted">Only what you type when you create an account — first and last name, username and email address — plus the sign-in metadata ASP.NET Identity needs (password hash, security stamp, lockout counters).</p>
            </div>

            <div class="stack gap-2">
                <h2>How it is used</h2>
                <p class="text-muted">To authenticate you, to attribute the portfolio records you create, and to send a password reset link when you ask for one. Nothing is sold, shared or used for advertising.</p>
            </div>

            <div class="stack gap-2">
                <h2>Cookies and sign-in</h2>
                <p class="text-muted">Signing in sets one authentication cookie, marked <span class="mono">Secure</span>, that expires after 30 days. Sign-in with Google passes through Google's own OAuth flow; the only data kept afterwards is your email and display name. Theme and menu preferences are stored in your browser's local storage and never leave your device.</p>
            </div>

            <div class="stack gap-2">
                <h2>Public content</h2>
                <p class="text-muted">The portfolio itself — projects, skills, experience, education, contact channels and your CV — is deliberately public. Anything you would rather keep private should not be entered into those forms.</p>
            </div>

            <div class="stack gap-2">
                <h2>Deleting your data</h2>
                <p class="text-muted">Records you archive in the admin area are soft-deleted and stay recoverable. To have an account and its rows removed completely, email the address below and it will be handled manually.</p>
            </div>

            <div class="card card--accent panel">
                <h2 class="card__title mb-2">Questions</h2>
                <p class="text-muted mb-3">Write to
                    <a href="mailto:dev.mohamed104saber@gmail.com">dev.mohamed104saber@gmail.com</a>
                    and you'll get a reply from the account owner directly.
                </p>
                <a class="btn btn--quiet btn--sm" asp-controller="Home" asp-action="Index">Back to the portfolio</a>
            </div>
        </div>
    </div>
</section>
