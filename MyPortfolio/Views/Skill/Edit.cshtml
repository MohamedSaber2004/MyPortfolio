@using BusinessLogicLayer.DTos.SkillDTos
@model SkillDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit skill";
    ViewData["PageKicker"] = "Skills";
    ViewData["PageTitle"] = "Edit skill";
    ViewData["PageDesc"] = string.IsNullOrWhiteSpace(Model.SkillName) ? "Update this skill entry." : Model.SkillName;
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
    <a class="btn btn--soft" asp-action="Details" asp-route-id="@Model.Id">
        <ui-icon name="eye" size="sm" />
        <span class="btn__label">Details</span>
    </a>
}

@if (Model.IsDeleted)
{
    <div class="alert alert--warning mb-5">
        <ui-icon name="warn" />
        <div class="alert__body">
            <p class="alert__title">This skill is archived</p>
            <p class="alert__text">Saving keeps it off the public page. Use Restore in the list to publish it again.</p>
        </div>
    </div>
}

<section class="card max-w-md">
    <div class="card__bd">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate class="form-grid">
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="Id" />

            <div class="field">
                <label asp-for="SkillName" class="field__label"></label>
                <input asp-for="SkillName" class="input" autocomplete="off" />
                <span asp-validation-for="SkillName"></span>
            </div>

            <div class="field">
                <label asp-for="ProficiencyLevel" class="field__label"></label>
                <select asp-for="ProficiencyLevel" class="select" asp-items="Html.GetEnumSelectList<ProficiencyLevels>()"></select>
                <span class="field__hint">Drives the bar width on the public page.</span>
                <span asp-validation-for="ProficiencyLevel"></span>
            </div>

            <div class="form-foot">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="save" size="sm" />
                    <span class="btn__label">Save changes</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
