@using BusinessLogicLayer.DTos.SkillDTos
@model IEnumerable<SkillDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Skills";
    ViewData["PageKicker"] = "Content";
    ViewData["PageTitle"] = "Skills";
    ViewData["PageDesc"] = "Everything the landing Skills grid is built from.";

    var rows = Model?.ToList() ?? [];
    var live = rows.Count(s => !s.IsDeleted);
}

@section PageActions {
    <a class="btn btn--primary" asp-action="Create">
        <ui-icon name="plus" size="sm" />
        <span class="btn__label">New skill</span>
    </a>
}

<form class="toolbar" asp-action="Index" method="get" autocomplete="off" data-search="#skillTable">
    <span class="input-wrap grow">
        <span class="input-wrap__icon"><ui-icon name="search" size="sm" /></span>
        <label class="sr-only" for="skillSearchName">Search skills</label>
        <input class="input" id="skillSearchName" name="skillSearchName" type="search"
               value="@Context.Request.Query["skillSearchName"]" placeholder="Name or level…" />
    </span>
    <button class="btn btn--soft" type="submit">
        <ui-icon name="search" size="sm" />
        <span class="btn__label">Search</span>
    </button>
    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["skillSearchName"]))
    {
        <a class="btn btn--quiet" asp-action="Index">Clear</a>
    }
</form>

<div id="skillTable">
    @if (rows.Count == 0)
    {
        <div class="card">
            <partial name="_EmptyState" model="@(new EmptyStateVm {
                Title = "No skills match",
                Text = "Nothing is shown on the public Skills grid until at least one skill exists.",
                Icon = "layers",
                ActionHref = Url.Action("Create", "Skill"),
                ActionLabel = "Add the first skill" })" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack table--sticky">
                <caption class="sr-only">Skills, newest first as saved</caption>
                <thead>
                    <tr>
                        <th scope="col">Skill</th>
                        <th scope="col">Level</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="table__num">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in rows)
                    {
                        <tr data-deleted="@(s.IsDeleted ? "true" : "false")">
                            <td data-label="Skill">
                                <div class="table__main">
                                    <a class="table__primary" asp-action="Details" asp-route-id="@s.Id">@s.SkillName</a>
                                </div>
                            </td>
                            <td data-label="Level">@Display.Level(s.ProficiencyLevel)</td>
                            <td data-label="Status">
                                <span class="badge badge--@(s.IsDeleted ? "danger" : "success")">
                                    @(s.IsDeleted ? "Archived" : "Live")
                                </span>
                            </td>
                            <td data-label="Actions">
                                <div class="table__actions">
                                    <a class="btn btn--icon btn--quiet" asp-action="Details" asp-route-id="@s.Id"
                                       data-tip="Details" aria-label="@($"Details for {s.SkillName}")">
                                        <ui-icon name="eye" size="sm" />
                                    </a>
                                    <a class="btn btn--icon btn--quiet" asp-action="Edit" asp-route-id="@s.Id"
                                       data-tip="Edit" aria-label="@($"Edit {s.SkillName}")">
                                        <ui-icon name="edit" size="sm" />
                                    </a>
                                    @if (s.IsDeleted)
                                    {
                                        <form asp-action="Restore" asp-route-id="@s.Id" method="post"
                                              data-confirm-title="Restore skill"
                                              data-confirm="@($"Put {s.SkillName} back on the public page?")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--success" type="submit"
                                                    data-tip="Restore" aria-label="@($"Restore {s.SkillName}")">
                                                <ui-icon name="restore" size="sm" />
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-route-id="@s.Id" method="post"
                                              data-confirm-title="Archive skill"
                                              data-confirm="@($"{s.SkillName} disappears from the public Skills grid. You can restore it later.")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--danger" type="submit"
                                                    data-tip="Delete" aria-label="@($"Delete {s.SkillName}")">
                                                <ui-icon name="del" size="sm" />
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="meta mt-3">
            <span class="meta__item">@live live</span>
            <span class="meta__item">@(rows.Count - live) archived</span>
        </p>
    }
</div>
