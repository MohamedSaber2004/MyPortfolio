@using BusinessLogicLayer.DTos.SkillDTos
@model SkillDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "New skill";
    ViewData["PageKicker"] = "Skills";
    ViewData["PageTitle"] = "Add a skill";
    ViewData["PageDesc"] = "It joins the public Skills grid as soon as you save.";
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
}

<section class="card max-w-md">
    <div class="card__bd">
        <form asp-action="Create" method="post" novalidate class="form-grid">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="field">
                <label asp-for="SkillName" class="field__label"></label>
                <input asp-for="SkillName" class="input" placeholder="e.g. C#, SQL, React" autocomplete="off" />
                <span asp-validation-for="SkillName"></span>
            </div>

            <div class="field">
                <label asp-for="ProficiencyLevel" class="field__label"></label>
                <select asp-for="ProficiencyLevel" class="select" asp-items="Html.GetEnumSelectList<ProficiencyLevels>()"></select>
                <span class="field__hint">Drives the bar width on the public page.</span>
                <span asp-validation-for="ProficiencyLevel"></span>
            </div>

            <div class="form-foot">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="check" size="sm" />
                    <span class="btn__label">Create skill</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
