@using BusinessLogicLayer.DTos.SkillDTos
@model SkillDetailsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.SkillName;
    ViewData["PageKicker"] = "Skill";
    ViewData["PageTitle"] = Model.SkillName;
    ViewData["PageDesc"] = Display.Level(Model.ProficiencyLevel);
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">All skills</a>
    <a class="btn btn--primary" asp-action="Edit" asp-route-id="@Model.Id">
        <ui-icon name="edit" size="sm" />
        <span class="btn__label">Edit</span>
    </a>
}

<div class="dash-grid dash-grid--split">
    <section class="card">
        <h2 class="sr-only">Skill details</h2>
        <dl class="dl">
            <div class="dl__row">
                <dt>Status</dt>
                <dd>
                    <span class="badge badge--@(Model.IsDeleted ? "danger" : "success")">
                        @(Model.IsDeleted ? "Archived" : "Live")
                    </span>
                </dd>
            </div>
            <div class="dl__row">
                <dt>Proficiency</dt>
                <dd>@Display.Level(Model.ProficiencyLevel)</dd>
            </div>
            <div class="dl__row">
                <dt>Bar on public page</dt>
                <dd class="table__num">@Display.LevelPercent(Model.ProficiencyLevel)%</dd>
            </div>
            <div class="dl__row">
                <dt>Record</dt>
                <dd class="mono">#@Model.Id</dd>
            </div>
        </dl>
    </section>

    <div class="dash-grid">
        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Audit trail</h2>
            </header>
            <dl class="dl">
                <div class="dl__row">
                    <dt>Created by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Created on</dt>
                    <dd>@Display.Stamp(Model.CreatedOn)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.LastModifiedBy) ? "—" : Model.LastModifiedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed on</dt>
                    <dd>@Display.Stamp(Model.LastModifiedOn)</dd>
                </div>
            </dl>
        </section>

        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Danger zone</h2>
            </header>
            @if (Model.IsDeleted)
            {
                <form asp-action="Restore" asp-route-id="@Model.Id" method="post"
                     data-confirm-title="Restore skill"
                     data-confirm="@($"Put {Model.SkillName} back on the public page?")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--success btn--block" type="submit">
                        <ui-icon name="restore" size="sm" />
                        <span class="btn__label">Restore this skill</span>
                    </button>
                </form>
            }
            else
            {
                <p class="text-sm text-muted mb-3">Archiving hides it from the public Skills grid and keeps the row recoverable.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                     data-confirm-title="Archive skill"
                     data-confirm="@($"{Model.SkillName} disappears from the public Skills grid. You can restore it later.")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--danger btn--block" type="submit">
                        <ui-icon name="del" size="sm" />
                        <span class="btn__label">Archive this skill</span>
                    </button>
                </form>
            }
        </section>
    </div>
</div>
