@model MyPortfolio.Models.DashboardModels.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["PageKicker"] = "Overview";
    ViewData["PageTitle"] = $"Welcome back, {Model.UserName}";
    ViewData["PageDesc"] = "Every number here is read from the rows behind your public portfolio.";

    int Active(string controller) => Model.Counters.First(c => c.Controller == controller).Active;
    var social = Active("SocialLink");
    var channels = Active("Contact");
    var datedProjects = Model.ProjectsByYear.Sum(y => y.Value);
}

@section PageActions {
    <a class="btn btn--quiet btn--sm" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">
        <ui-icon name="external" size="sm" />
        <span class="btn__label">Live site</span>
    </a>
    <a class="btn btn--primary btn--sm" asp-controller="Project" asp-action="Create">
        <ui-icon name="plus" size="sm" />
        <span class="btn__label">New project</span>
    </a>
}

<div class="stack gap-6">

    <section class="dash-grid dash-grid--stats" aria-label="Content counts">
        @foreach (var c in Model.Counters.Take(4))
        {
            <a class="stat" asp-controller="@c.Controller" asp-action="Index">
                <span class="tile tile--accent stat__icon"><ui-icon name="@c.Icon" /></span>
                <span class="stat__label">@c.Label</span>
                <span class="stat__value" data-count="@c.Active">@c.Active</span>
                <span class="stat__meta">@(c.Archived > 0 ? $"{c.Archived} archived" : "Nothing archived")</span>
            </a>
        }
    </section>

    <div class="dash-grid dash-grid--split">

        <section class="card panel" aria-labelledby="latestHead">
            <header class="panel__hd">
                <h2 class="card__title" id="latestHead">Latest content</h2>
                <a class="btn btn--quiet btn--sm" asp-controller="Project" asp-action="Index">
                    <span class="btn__label">Manage</span>
                    <ui-icon name="chevR" size="sm" />
                </a>
            </header>
            @if (Model.Entries.Count == 0)
            {
                <partial name="_EmptyState" model="@(new EmptyStateVm {
                    Title = "No dated content yet",
                    Text = "Add a project, a role or a degree and it lands here.",
                    Icon = "history",
                    ActionHref = Url.Action("Create", "Project"),
                    ActionLabel = "Add a project" })" />
            }
            else
            {
                <ul class="feed">
                    @foreach (var e in Model.Entries)
                    {
                        <li class="feed__item">
                            <span class="tile"><ui-icon name="@e.Icon" size="sm" /></span>
                            <a class="feed__text" asp-controller="@e.Controller" asp-action="Edit" asp-route-id="@e.Id">@e.Text</a>
                            <span class="feed__time">@e.When</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <div class="dash-grid">
            <section class="card panel" aria-labelledby="levelsHead">
                <header class="panel__hd">
                    <h2 class="card__title" id="levelsHead">Skill levels</h2>
                    <a class="badge badge--pill" asp-controller="Skill" asp-action="Index">@(Active("Skill") + " listed")</a>
                </header>
                <div class="bars">
                    @foreach (var s in Model.SkillLevels)
                    {
                        <div class="bars__row">
                            <span class="bars__label">@s.Label</span>
                            <span class="bars__track"><span class="bars__fill" style="--value:@s.Percent%;"></span></span>
                            <span class="bars__value">@s.Value</span>
                        </div>
                    }
                </div>
            </section>

            <section class="card panel" aria-labelledby="yearsHead">
                <header class="panel__hd">
                    <h2 class="card__title" id="yearsHead">Projects by year</h2>
                    <span class="text-sm text-faint tabular">@datedProjects</span>
                </header>
                @if (Model.ProjectsByYear.Count == 0)
                {
                    <p class="text-sm text-muted">No project carries a start date yet.</p>
                }
                else
                {
                    <div class="spark" role="img" aria-label="Projects started per year">
                        @foreach (var y in Model.ProjectsByYear)
                        {
                            <span class="spark__bar" style="--v:@y.Percent;" title="@($"{y.Label}: {y.Value}")"></span>
                        }
                    </div>
                    <dl class="dl mt-4">
                        @foreach (var y in Model.ProjectsByYear)
                        {
                            <div class="dl__row">
                                <dt>@y.Label</dt>
                                <dd>@y.Value</dd>
                            </div>
                        }
                    </dl>
                }
            </section>
        </div>
    </div>

    <div class="dash-grid dash-grid--split">

        <section class="card panel" aria-labelledby="checksHead">
            <header class="panel__hd">
                <h2 class="card__title" id="checksHead">Publishing checks</h2>
                <span class="badge @(Model.Checks.All(c => c.Passed) ? "badge--success" : "badge--warning")">
                    @Model.Checks.Count(c => c.Passed) of @Model.Checks.Count
                </span>
            </header>
            <ul class="list">
                @foreach (var k in Model.Checks)
                {
                    <li class="list__item">
                        <span class="tile tile--@(k.Passed ? "success" : "warning")">
                            <ui-icon name="@(k.Passed ? "check" : "warn")" size="sm" />
                        </span>
                        <span class="grow @(k.Passed ? "text-muted" : "text-strong")">@k.Text</span>
                        <a class="btn btn--quiet btn--sm" asp-controller="@k.Controller" asp-action="@(k.Passed ? "Index" : "Create")">
                            <span class="btn__label">@(k.Passed ? "View" : "Fix")</span>
                        </a>
                    </li>
                }
            </ul>
        </section>

        <div class="dash-grid">
            <section class="card panel" aria-labelledby="accessHead">
                <header class="panel__hd">
                    <h2 class="card__title" id="accessHead">Access &amp; files</h2>
                </header>
                <dl class="dl">
                    <div class="dl__row">
                        <dt>CV on file</dt>
                        <dd>
                            @if (Model.Cv is null)
                            {
                                <span class="text-danger">None uploaded</span>
                            }
                            else
                            {
                                <a href="~/Files/@Model.Cv.FileName" target="_blank" rel="noopener">@Model.Cv.FileName</a>
                            }
                        </dd>
                    </div>
                    @if (Model.Cv is not null)
                    {
                        <div class="dl__row">
                            <dt>Uploaded</dt>
                            <dd>@Model.Cv.UploadedAt.ToString("dd MMM yyyy") · @Model.Cv.UploadedBy</dd>
                        </div>
                    }
                    <div class="dl__row">
                        <dt>Accounts</dt>
                        <dd class="flex gap-2">
                            <a class="badge badge--pill" asp-controller="User" asp-action="Index">@($"{Model.Users} users")</a>
                            <a class="badge badge--pill" asp-controller="Role" asp-action="Index">@($"{Model.Roles} roles")</a>
                        </dd>
                    </div>
                    <div class="dl__row">
                        <dt>Outward links</dt>
                        <dd>@social social · @channels contact</dd>
                    </div>
                    <div class="dl__row">
                        <dt>Published rows</dt>
                        <dd data-count="@Model.TotalActive">@Model.TotalActive</dd>
                    </div>
                </dl>
                <div class="flex gap-2 mt-4 wrap">
                    <a class="btn btn--soft btn--sm" asp-controller="CvDocument" asp-action="Index">
                        <ui-icon name="pdf" size="sm" />
                        <span class="btn__label">Documents</span>
                    </a>
                    <a class="btn btn--soft btn--sm" asp-controller="User" asp-action="Index">
                        <ui-icon name="users" size="sm" />
                        <span class="btn__label">Users</span>
                    </a>
                    <a class="btn btn--soft btn--sm" asp-controller="Role" asp-action="Index">
                        <ui-icon name="shield" size="sm" />
                        <span class="btn__label">Roles</span>
                    </a>
                </div>
            </section>

            <section class="card panel" aria-labelledby="platformsHead">
                <header class="panel__hd">
                    <h2 class="card__title" id="platformsHead">Linked platforms</h2>
                    <a class="btn btn--quiet btn--sm" asp-controller="SocialLink" asp-action="Create">
                        <ui-icon name="plus" size="sm" />
                        <span class="btn__label">Add</span>
                    </a>
                </header>
                @if (Model.Platforms.Count == 0)
                {
                    <p class="text-sm text-muted">Nothing linked to the Elsewhere section yet.</p>
                }
                else
                {
                    <ul class="tag-list">
                        @foreach (var p in Model.Platforms)
                        {
                            <li><span class="tag">@p</span></li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
</div>
