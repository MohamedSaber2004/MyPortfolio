@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-brand-panel">
            <div class="auth-brand-content">
                <div class="auth-brand-logo">
                    <i class="bi bi-code-slash"></i>
                </div>
                <h2 class="auth-brand-name">MyPortfolio</h2>
                <p class="auth-brand-desc">Build, manage and showcase your professional portfolio with ease.</p>
                <ul class="auth-features">
                    <li class="auth-feature-item">
                        <i class="bi bi-laptop"></i>
                        <span>Responsive project showcase</span>
                    </li>
                    <li class="auth-feature-item">
                        <i class="bi bi-bar-chart"></i>
                        <span>Detailed analytics dashboard</span>
                    </li>
                    <li class="auth-feature-item">
                        <i class="bi bi-shield-check"></i>
                        <span>Role-based access control</span>
                    </li>
                    <li class="auth-feature-item">
                        <i class="bi bi-palette"></i>
                        <span>Dark & light theme support</span>
                    </li>
                </ul>
            </div>
            <p class="auth-brand-footer">&copy; @DateTime.Now.Year MyPortfolio. All rights reserved.</p>
        </div>

        <div class="auth-form-panel">
            <div class="auth-form-inner">
                <div class="auth-form-header">
                    <h1 class="auth-title">Welcome back</h1>
                    <p class="auth-subtitle">Sign in to manage your portfolio.</p>
                </div>

                @if (TempData["Message"] is not null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <span class="flex-grow-1">@TempData["Message"]</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" method="post" novalidate class="needs-validation">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="position-relative">
                            <input asp-for="Password" class="form-control" placeholder="Enter your password" required id="loginPassword" />
                            <button type="button" class="auth-pw-toggle" data-pw-toggle="loginPassword" tabindex="-1" aria-label="Toggle password visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small fw-normal">Keep me signed in</label>
                        </div>
                        <a asp-action="ForgetPassword" class="auth-link small">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary auth-btn w-100" data-loading>
                        <span class="btn-text">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Sign In</span>
                        </span>
                        <span class="btn-loader spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    </button>
                </form>

                <div class="auth-divider">
                    <span>or continue with</span>
                </div>

                <form asp-controller="Account" asp-action="GoogleLogin" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary auth-btn w-100">
                        <i class="bi bi-google"></i>
                        <span>Sign in with Google</span>
                    </button>
                </form>

                <p class="auth-switch">
                    Don't have an account?
                    <a asp-action="Register" class="auth-link fw-semibold">Create one</a>
                </p>
            </div>
        </div>
    </div>
</div>
