@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1 class="auth__title">Reset your password</h1>
<p class="auth__sub">Give us the email on your account and we'll send a reset link.</p>

<form class="auth__form" asp-action="SendResetPasswordLink" method="post" novalidate>
    <div asp-validation-summary="All"></div>

    <div class="field">
        <label asp-for="Email" class="field__label"></label>
        <span class="input-wrap">
            <span class="input-wrap__icon"><ui-icon name="mailOpen" size="sm" /></span>
            <input asp-for="Email" class="input" type="email" placeholder="name@example.com"
                   autocomplete="email" inputmode="email" />
        </span>
        <span asp-validation-for="Email"></span>
    </div>

    <button class="btn btn--primary btn--lg btn--block" type="submit">
        <ui-icon name="send" size="sm" />
        <span class="btn__label">Send reset link</span>
    </button>
</form>

<p class="auth__foot">
    Remembered it?
    <a asp-action="Login">Back to sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
