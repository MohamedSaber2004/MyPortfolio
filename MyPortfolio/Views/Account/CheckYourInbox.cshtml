@{
    ViewData["Title"] = "Check Your Inbox";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <i class="bi bi-envelope-check"></i>
            </div>
            <h1 class="auth-title">Check your inbox</h1>
            <p class="auth-subtitle">We've sent you an email with instructions to reset your password.</p>
        </div>
        <div class="auth-body">
            <div class="text-center mb-4">
                <i class="bi bi-envelope-open text-primary" style="font-size: 2.5rem;"></i>
            </div>
            <a href="https://mail.google.com/mail/u/1/#inbox" target="_blank" class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center gap-2 mb-2">
                <i class="bi bi-box-arrow-up-right"></i>
                <span>Go To Your Inbox</span>
            </a>
            <div class="mt-3 text-center auth-meta">
                <a asp-action="Login" class="text-decoration-none text-primary">Back to Sign in</a>
            </div>
        </div>
    </div>
</div>
