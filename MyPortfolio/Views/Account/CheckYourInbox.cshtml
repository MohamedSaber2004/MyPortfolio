@{
    ViewData["Title"] = "Check your inbox";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1 class="auth__title">Check your inbox</h1>
<p class="auth__sub">If that address has an account, a reset link is on its way.</p>

<ol class="auth__steps">
    <li>Open the email titled <strong>Reset Password</strong>.</li>
    <li>Follow the link — it only works once and expires with the token.</li>
    <li>Nothing there? Check spam, then request the link again.</li>
</ol>

<a class="btn btn--outline btn--block" href="https://mail.google.com/mail/u/1/#inbox" target="_blank" rel="noopener">
    <ui-icon name="external" size="sm" />
    <span class="btn__label">Open Gmail</span>
</a>

<p class="auth__foot">
    <a asp-action="ForgetPassword">Request another link</a>
    &nbsp;·&nbsp;
    <a asp-action="Login">Back to sign in</a>
</p>
