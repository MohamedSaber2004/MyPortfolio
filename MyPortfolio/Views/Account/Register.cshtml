@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    ViewData["WidePanel"] = true;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1 class="auth__title">Create your account</h1>
<p class="auth__sub">Accounts are for managing the portfolio, not for public visitors.</p>

<form class="auth__form" asp-action="Register" asp-controller="Account" method="post" novalidate>
    <div asp-validation-summary="All"></div>

    <div class="form-grid form-grid--2">
        <div class="field">
            <label asp-for="FirstName" class="field__label"></label>
            <input asp-for="FirstName" class="input" placeholder="First name" autocomplete="given-name" />
            <span asp-validation-for="FirstName"></span>
        </div>
        <div class="field">
            <label asp-for="LastName" class="field__label"></label>
            <input asp-for="LastName" class="input" placeholder="Last name" autocomplete="family-name" />
            <span asp-validation-for="LastName"></span>
        </div>
    </div>

    <div class="field">
        <label asp-for="UserName" class="field__label"></label>
        <span class="input-wrap">
            <span class="input-wrap__icon">@@</span>
            <input asp-for="UserName" class="input" placeholder="username" autocomplete="username" />
        </span>
        <span asp-validation-for="UserName"></span>
    </div>

    <div class="field">
        <label asp-for="Email" class="field__label"></label>
        <span class="input-wrap">
            <span class="input-wrap__icon"><ui-icon name="mail" size="sm" /></span>
            <input asp-for="Email" class="input" type="email" placeholder="name@example.com"
                   autocomplete="email" inputmode="email" />
        </span>
        <span asp-validation-for="Email"></span>
    </div>

    <div class="form-grid form-grid--2">
        <div class="field">
            <div class="flex items-baseline justify-between gap-3">
                <label asp-for="Password" class="field__label"></label>
                <button class="btn btn--quiet btn--sm" type="button" data-pw-toggle="Password"
                        aria-pressed="false" aria-label="Show password">
                    <ui-icon name="eye" size="sm" />
                </button>
            </div>
            <input asp-for="Password" class="input" type="password" placeholder="Choose a password"
                   autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword" class="field__label"></label>
            <input asp-for="ConfirmPassword" class="input" type="password" placeholder="Repeat it"
                   autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>
    </div>

    <div class="field">
        <label class="choice">
            <input asp-for="IsAgree" type="checkbox" />
            <span class="choice__text">
                I agree to the
                <a asp-controller="Home" asp-action="Privacy">terms and privacy note</a>.
                <span class="choice__hint">Required — accounts are created manually for this portfolio.</span>
            </span>
        </label>
        <span asp-validation-for="IsAgree"></span>
    </div>

    <button class="btn btn--primary btn--lg btn--block" type="submit">
        <ui-icon name="plus" size="sm" />
        <span class="btn__label">Create account</span>
    </button>
</form>

<div class="auth__divider">or continue with</div>

<form asp-controller="Account" asp-action="GoogleLogin" method="post">
    <button class="btn btn--outline btn--block" type="submit">
        <ui-icon name="web" size="sm" />
        <span class="btn__label">Google</span>
    </button>
</form>

<p class="auth__foot">
    Already registered?
    <a asp-action="Login">Sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
