@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="text-center">
        <div class="auth-logo mx-auto">
            <i class="bi bi-person-plus"></i>
        </div>
        <h1 class="auth-title">Create your account</h1>
        <p class="auth-subtitle">Join to explore the full portfolio experience.</p>
    </div>

    <div class="mt-4">
        <form asp-action="Register" method="post" asp-controller="Account" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-person input-icon"></i>
                        <input asp-for="FirstName" class="form-control" placeholder="First name" required />
                    </div>
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-person input-icon"></i>
                        <input asp-for="LastName" class="form-control" placeholder="Last name" required />
                    </div>
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3 mt-3">
                <label asp-for="UserName" class="form-label"></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-at input-icon"></i>
                    <input asp-for="UserName" class="form-control" placeholder="Choose a username" required />
                </div>
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-icon-wrap">
                    <i class="bi bi-envelope input-icon"></i>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-lock input-icon"></i>
                        <input asp-for="Password" class="form-control" placeholder="Create password" required type="password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-lock-fill input-icon"></i>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm password" required type="password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-check mt-3">
                <input asp-for="IsAgree" class="form-check-input" required />
                <label asp-for="IsAgree" class="form-check-label">
                    I agree to the <a href="#" class="text-decoration-none fw-semibold" style="color: #6366f1;">Terms & Conditions</a>
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4">
                <i class="bi bi-person-check me-1"></i> Create Account
            </button>
        </form>

        <div class="auth-divider">or continue with</div>

        <form asp-controller="Account" asp-action="GoogleLogin" method="post">
            <button type="submit" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-google"></i>
                Sign up with Google
            </button>
        </form>

        <div class="mt-4 text-center auth-footer-text">
            Already have an account?
            <a asp-action="Login">Sign in</a>
        </div>
    </div>
</div>
