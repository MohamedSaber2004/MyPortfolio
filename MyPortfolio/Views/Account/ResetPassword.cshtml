@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1 class="auth__title">Choose a new password</h1>
<p class="auth__sub">You opened the reset link, so this is the last step.</p>

<form class="auth__form" asp-action="ResetPassword" method="post" novalidate>
    <div asp-validation-summary="All"></div>

    <div class="field">
        <div class="flex items-baseline justify-between gap-3">
            <label asp-for="Password" class="field__label"></label>
            <button class="btn btn--quiet btn--sm" type="button" data-pw-toggle="Password"
                    aria-pressed="false" aria-label="Show password">
                <ui-icon name="eye" size="sm" />
            </button>
        </div>
        <input asp-for="Password" class="input" type="password" placeholder="New password" autocomplete="new-password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div class="field">
        <label asp-for="ConfirmPassword" class="field__label"></label>
        <input asp-for="ConfirmPassword" class="input" type="password" placeholder="Repeat it" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button class="btn btn--primary btn--lg btn--block" type="submit">
        <ui-icon name="save" size="sm" />
        <span class="btn__label">Change password</span>
    </button>
</form>

<p class="auth__foot">
    <a asp-action="Login">Back to sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
