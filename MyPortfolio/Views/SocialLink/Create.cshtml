@using MyPortfolio.Models.SocialLinkModels
@model SocialLinkViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "New social link";
    ViewData["PageKicker"] = "Social links";
    ViewData["PageTitle"] = "Add a social link";
    ViewData["PageDesc"] = "It joins the public Elsewhere grid as soon as you save.";
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
}

<section class="card">
    <div class="card__bd">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-grid form-grid--2">
                <div class="field">
                    <label asp-for="PlatformName" class="field__label"></label>
                    <input asp-for="PlatformName" class="input" list="platformOptions" placeholder="e.g. GitHub" />
                    <datalist id="platformOptions">
                        <option value="GitHub"></option>
                        <option value="LinkedIn"></option>
                        <option value="Twitter"></option>
                        <option value="X"></option>
                        <option value="Facebook"></option>
                        <option value="Instagram"></option>
                        <option value="YouTube"></option>
                        <option value="StackOverflow"></option>
                        <option value="Reddit"></option>
                        <option value="Medium"></option>
                        <option value="Dev.to"></option>
                        <option value="Hashnode"></option>
                        <option value="Portfolio"></option>
                    </datalist>
                    <span class="field__hint">Brand colour and icon on the public tile key off this name.</span>
                    <span asp-validation-for="PlatformName"></span>
                </div>

                <div class="field">
                    <label asp-for="URL" class="field__label"></label>
                    <input asp-for="URL" class="input" type="url" inputmode="url"
                           placeholder="https://github.com/your-username" autocomplete="off" />
                    <span class="field__hint">Full absolute URL, starting with https://.</span>
                    <span asp-validation-for="URL"></span>
                </div>
            </div>

            <div class="form-foot">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="check" size="sm" />
                    <span class="btn__label">Create link</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
