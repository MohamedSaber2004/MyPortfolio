@using MyPortfolio.Models.SocialLinkModels
@model IEnumerable<SocialLinkViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Social links";
    ViewData["PageKicker"] = "Content";
    ViewData["PageTitle"] = "Social links";
    ViewData["PageDesc"] = "Everything the landing Elsewhere grid is built from.";

    var rows = Model?.ToList() ?? [];
    var live = rows.Count(l => !l.IsDeleted);
}

@section PageActions {
    <a class="btn btn--primary" asp-action="Create">
        <ui-icon name="plus" size="sm" />
        <span class="btn__label">New link</span>
    </a>
}

<form class="toolbar" asp-action="Index" method="get" autocomplete="off" data-search="#socialTable">
    <span class="input-wrap grow">
        <span class="input-wrap__icon"><ui-icon name="search" size="sm" /></span>
        <label class="sr-only" for="socialLinkSearchName">Search social links</label>
        <input class="input" id="socialLinkSearchName" name="socialLinkSearchName" type="search"
               value="@Context.Request.Query["socialLinkSearchName"]" placeholder="Platform or URL…" />
    </span>
    <button class="btn btn--soft" type="submit">
        <ui-icon name="search" size="sm" />
        <span class="btn__label">Search</span>
    </button>
    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["socialLinkSearchName"]))
    {
        <a class="btn btn--quiet" asp-action="Index">Clear</a>
    }
</form>

<div id="socialTable">
    @if (rows.Count == 0)
    {
        <div class="card">
            <partial name="_EmptyState" model="@(new EmptyStateVm {
                Title = "No social links match",
                Text = "Nothing is shown on the public Elsewhere grid until at least one link exists.",
                Icon = "share",
                ActionHref = Url.Action("Create", "SocialLink"),
                ActionLabel = "Add the first link" })" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack table--sticky">
                <caption class="sr-only">Social links, newest first as saved</caption>
                <thead>
                    <tr>
                        <th scope="col">Platform</th>
                        <th scope="col">URL</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="table__num">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var link in rows)
                    {
                        <tr data-deleted="@(link.IsDeleted ? "true" : "false")">
                            <td data-label="Platform">
                                <div class="table__main">
                                    <a class="table__primary" asp-action="Details" asp-route-id="@link.Id">@link.PlatformName</a>
                                </div>
                            </td>
                            <td data-label="URL">
                                <div class="table__main">
                                    <a href="@link.URL" target="_blank" rel="noopener">@link.URL<ui-icon name="external" size="sm" /></a>
                                </div>
                            </td>
                            <td data-label="Status">
                                <span class="badge badge--@(link.IsDeleted ? "danger" : "success")">
                                    @(link.IsDeleted ? "Archived" : "Live")
                                </span>
                            </td>
                            <td data-label="Actions">
                                <div class="table__actions">
                                    <a class="btn btn--icon btn--quiet" asp-action="Details" asp-route-id="@link.Id"
                                       data-tip="Details" aria-label="@($"Details for {link.PlatformName}")">
                                        <ui-icon name="eye" size="sm" />
                                    </a>
                                    <a class="btn btn--icon btn--quiet" asp-action="Edit" asp-route-id="@link.Id"
                                       data-tip="Edit" aria-label="@($"Edit {link.PlatformName}")">
                                        <ui-icon name="edit" size="sm" />
                                    </a>
                                    @if (link.IsDeleted)
                                    {
                                        <form asp-action="Restore" asp-route-id="@link.Id" method="post"
                                              data-confirm-title="Restore link"
                                              data-confirm="@($"Put {link.PlatformName} back on the public page?")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--success" type="submit"
                                                    data-tip="Restore" aria-label="@($"Restore {link.PlatformName}")">
                                                <ui-icon name="restore" size="sm" />
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-route-id="@link.Id" method="post"
                                              data-confirm-title="Archive link"
                                              data-confirm="@($"{link.PlatformName} disappears from the public Elsewhere grid. You can restore it later.")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--danger" type="submit"
                                                    data-tip="Delete" aria-label="@($"Delete {link.PlatformName}")">
                                                <ui-icon name="del" size="sm" />
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="meta mt-3">
            <span class="meta__item">@live live</span>
            <span class="meta__item">@(rows.Count - live) archived</span>
        </p>
    }
</div>
