@using BusinessLogicLayer.DTos.SocialLinksDTos
@model SocialLinksDetailsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.PlatformName;
    ViewData["PageKicker"] = "Social link";
    ViewData["PageTitle"] = Model.PlatformName;
    ViewData["PageDesc"] = Model.URL;

    var site = Model.URL?.Trim() ?? string.Empty;
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">All links</a>
    <a class="btn btn--primary" asp-action="Edit" asp-route-id="@Model.Id">
        <ui-icon name="edit" size="sm" />
        <span class="btn__label">Edit</span>
    </a>
}

<div class="dash-grid dash-grid--split">
    <section class="card">
        <h2 class="sr-only">Social link details</h2>
        <dl class="dl">
            <div class="dl__row">
                <dt>Status</dt>
                <dd>
                    <span class="badge badge--@(Model.IsDeleted ? "danger" : "success")">
                        @(Model.IsDeleted ? "Archived" : "Live")
                    </span>
                </dd>
            </div>
            <div class="dl__row">
                <dt>Platform</dt>
                <dd>@Model.PlatformName</dd>
            </div>
            <div class="dl__row">
                <dt>Destination</dt>
                <dd>
                    @if (site.Length > 0)
                    {
                        <a href="@site" target="_blank" rel="noopener">@site<ui-icon name="external" size="sm" /></a>
                    }
                    else
                    {
                        <text>—</text>
                    }
                </dd>
            </div>
            <div class="dl__row">
                <dt>Record</dt>
                <dd class="mono">#@Model.Id</dd>
            </div>
        </dl>
    </section>

    <div class="dash-grid">
        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Audit trail</h2>
            </header>
            <dl class="dl">
                <div class="dl__row">
                    <dt>Created by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Created on</dt>
                    <dd>@Display.Stamp(Model.CreatedOn)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.LastModifiedBy) ? "—" : Model.LastModifiedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed on</dt>
                    <dd>@Display.Stamp(Model.LastModifiedOn)</dd>
                </div>
            </dl>
        </section>

        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Danger zone</h2>
            </header>
            @if (Model.IsDeleted)
            {
                <form asp-action="Restore" asp-route-id="@Model.Id" method="post"
                     data-confirm-title="Restore link"
                     data-confirm="@($"Put {Model.PlatformName} back on the public page?")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--success btn--block" type="submit">
                        <ui-icon name="restore" size="sm" />
                        <span class="btn__label">Restore this link</span>
                    </button>
                </form>
            }
            else
            {
                <p class="text-sm text-muted mb-3">Archiving hides the tile from the public Elsewhere grid and keeps the row recoverable.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                     data-confirm-title="Archive link"
                     data-confirm="@($"{Model.PlatformName} disappears from the public Elsewhere grid. You can restore it later.")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--danger btn--block" type="submit">
                        <ui-icon name="del" size="sm" />
                        <span class="btn__label">Archive this link</span>
                    </button>
                </form>
            }
        </section>
    </div>
</div>
