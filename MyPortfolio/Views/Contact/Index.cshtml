@using MyPortfolio.Models.ContactModels
@model IEnumerable<ContactViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Contacts";
    ViewData["PageKicker"] = "Inbox";
    ViewData["PageTitle"] = "Contact channels";
    ViewData["PageDesc"] = "Everything the landing contact grid is built from.";

    string Capitalise(string? value)
    {
        var text = (value ?? string.Empty).Trim();
        return text.Length == 0 ? "Channel" : char.ToUpperInvariant(text[0]) + text[1..];
    }

    var rows = Model?.ToList() ?? [];
    var live = rows.Count(c => !c.IsDeleted);
}

@section PageActions {
    <a class="btn btn--primary" asp-action="Create">
        <ui-icon name="plus" size="sm" />
        <span class="btn__label">New channel</span>
    </a>
}

<form class="toolbar" asp-action="Index" method="get" autocomplete="off" data-search="#contactTable">
    <span class="input-wrap grow">
        <span class="input-wrap__icon"><ui-icon name="search" size="sm" /></span>
        <label class="sr-only" for="contactSearchName">Search channels</label>
        <input class="input" id="contactSearchName" name="contactSearchName" type="search"
               value="@Context.Request.Query["contactSearchName"]" placeholder="Type or value…" />
    </span>
    <button class="btn btn--soft" type="submit">
        <ui-icon name="search" size="sm" />
        <span class="btn__label">Search</span>
    </button>
    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["contactSearchName"]))
    {
        <a class="btn btn--quiet" asp-action="Index">Clear</a>
    }
</form>

<div id="contactTable">
    @if (rows.Count == 0)
    {
        <div class="card">
            <partial name="_EmptyState" model="@(new EmptyStateVm {
                Title = "No channels match",
                Text = "Nothing is shown on the public contact grid until at least one channel exists.",
                Icon = "mail",
                ActionHref = Url.Action("Create", "Contact"),
                ActionLabel = "Add the first channel" })" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack table--sticky">
                <caption class="sr-only">Contact channels, in the order they were saved</caption>
                <thead>
                    <tr>
                        <th scope="col">Channel</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="table__num">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in rows)
                    {
                        <tr data-deleted="@(c.IsDeleted ? "true" : "false")">
                            <td data-label="Channel">
                                <div class="table__main">
                                    <a class="table__primary" asp-action="Details" asp-route-id="@c.Id">@Capitalise(c.ContactType)</a>
                                    <span class="table__sub">@c.ContactValue</span>
                                </div>
                            </td>
                            <td data-label="Status">
                                <span class="badge badge--@(c.IsDeleted ? "danger" : "success")">
                                    @(c.IsDeleted ? "Archived" : "Live")
                                </span>
                            </td>
                            <td data-label="Actions">
                                <div class="table__actions">
                                    <button class="btn btn--icon btn--quiet" type="button" data-copy="@c.ContactValue"
                                            data-tip="Copy" aria-label="@($"Copy {Capitalise(c.ContactType)} value")">
                                        <ui-icon name="copy" size="sm" />
                                    </button>
                                    <a class="btn btn--icon btn--quiet" asp-action="Details" asp-route-id="@c.Id"
                                       data-tip="Details" aria-label="@($"Details for {Capitalise(c.ContactType)}")">
                                        <ui-icon name="eye" size="sm" />
                                    </a>
                                    <a class="btn btn--icon btn--quiet" asp-action="Edit" asp-route-id="@c.Id"
                                       data-tip="Edit" aria-label="@($"Edit {Capitalise(c.ContactType)}")">
                                        <ui-icon name="edit" size="sm" />
                                    </a>
                                    @if (c.IsDeleted)
                                    {
                                        <form asp-action="Restore" asp-route-id="@c.Id" method="post"
                                              data-confirm-title="Restore channel"
                                              data-confirm="@($"Put {Capitalise(c.ContactType)} back on the public page?")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--success" type="submit"
                                                    data-tip="Restore" aria-label="@($"Restore {Capitalise(c.ContactType)}")">
                                                <ui-icon name="restore" size="sm" />
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-route-id="@c.Id" method="post"
                                              data-confirm-title="Archive channel"
                                              data-confirm="@($"{Capitalise(c.ContactType)} disappears from the public contact grid. You can restore it later.")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--danger" type="submit"
                                                    data-tip="Delete" aria-label="@($"Delete {Capitalise(c.ContactType)}")">
                                                <ui-icon name="del" size="sm" />
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="meta mt-3">
            <span class="meta__item">@live live</span>
            <span class="meta__item">@(rows.Count - live) archived</span>
        </p>
    }
</div>
