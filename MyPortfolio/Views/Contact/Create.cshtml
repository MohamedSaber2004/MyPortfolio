@using MyPortfolio.Models.ContactModels
@model ContactViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "New channel";
    ViewData["PageKicker"] = "Contacts";
    ViewData["PageTitle"] = "Add a contact channel";
    ViewData["PageDesc"] = "It joins the public contact grid as soon as you save.";
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
}

<section class="card">
    <div class="card__bd">
        <form asp-action="Create" method="post" novalidate autocomplete="off" class="form-grid form-grid--2">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="field">
                <label asp-for="ContactType" class="field__label"></label>
                <input asp-for="ContactType" class="input" list="contactTypeOptions" autocomplete="off"
                       placeholder="e.g. Email, Phone, WhatsApp" />
                <datalist id="contactTypeOptions">
                    <option value="Email"></option>
                    <option value="Phone"></option>
                    <option value="Mobile"></option>
                    <option value="Website"></option>
                    <option value="LinkedIn"></option>
                    <option value="GitHub"></option>
                    <option value="Twitter"></option>
                    <option value="Facebook"></option>
                    <option value="Instagram"></option>
                    <option value="Telegram"></option>
                    <option value="WhatsApp"></option>
                </datalist>
                <span class="field__hint">Sets which glyph the public card uses.</span>
                <span asp-validation-for="ContactType"></span>
            </div>

            <div class="field">
                <label asp-for="ContactValue" class="field__label"></label>
                <input asp-for="ContactValue" class="input" autocomplete="off"
                       placeholder="you@example.com, +201000000000, https://…" />
                <span class="field__hint">Email becomes a mailto: link, Phone a tel: link, WhatsApp a wa.me link.</span>
                <span asp-validation-for="ContactValue"></span>
            </div>

            <div class="form-foot form-grid__full">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="check" size="sm" />
                    <span class="btn__label">Create channel</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
