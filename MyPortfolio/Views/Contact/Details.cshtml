@using BusinessLogicLayer.DTos.ContactDTos
@model ContactDetailsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Contact channel";
    ViewData["PageKicker"] = "Contact";
    ViewData["PageTitle"] = string.IsNullOrWhiteSpace(Model.ContactType) ? "Contact channel" : Model.ContactType;
    ViewData["PageDesc"] = Model.ContactValue;

    (bool IsLink, string? Href, bool External) ContactLink(string? type, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return (false, null, false);
        var kind = (type ?? string.Empty).Trim().ToLowerInvariant();
        var raw = value.Trim();

        if (kind is "email" or "mail")
            return (true, raw.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase) ? raw : $"mailto:{raw}", false);

        if (kind is "phone" or "mobile" or "tel")
            return (true, "tel:" + new string(raw.Where(ch => char.IsDigit(ch) || ch == '+').ToArray()), false);

        if (kind is "whatsapp")
        {
            var digits = new string(raw.Where(ch => char.IsDigit(ch) || ch == '+').ToArray()).TrimStart('+');
            return digits.Length == 0 ? (false, null, false) : (true, $"https://wa.me/{digits}", true);
        }

        if (Uri.TryCreate(raw, UriKind.Absolute, out var absolute))
            return (true, absolute.ToString(), true);

        if (raw.StartsWith("www.", StringComparison.OrdinalIgnoreCase))
            return (true, $"https://{raw}", true);

        return (false, null, false);
    }

    var (isLink, href, external) = ContactLink(Model.ContactType, Model.ContactValue);
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">All channels</a>
    <a class="btn btn--primary" asp-action="Edit" asp-route-id="@Model.Id">
        <ui-icon name="edit" size="sm" />
        <span class="btn__label">Edit</span>
    </a>
}

<div class="dash-grid dash-grid--split">
    <section class="card">
        <h2 class="sr-only">Channel details</h2>
        <dl class="dl">
            <div class="dl__row">
                <dt>Status</dt>
                <dd>
                    <span class="badge badge--@(Model.IsDeleted ? "danger" : "success")">
                        @(Model.IsDeleted ? "Archived" : "Live")
                    </span>
                </dd>
            </div>
            <div class="dl__row">
                <dt>Channel type</dt>
                <dd>@Model.ContactType</dd>
            </div>
            <div class="dl__row">
                <dt>Contact value</dt>
                <dd>
                    <div class="flex items-center gap-2 wrap min-w-0">
                        @if (isLink)
                        {
                            <a class="break-any" href="@href"
                               target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)">
                                @Model.ContactValue
                                @if (external)
                                {
                                    <ui-icon name="external" size="sm" class="text-faint" />
                                }
                            </a>
                        }
                        else
                        {
                            <span class="break-any">@Model.ContactValue</span>
                        }
                        <button class="btn btn--icon btn--quiet" type="button" data-copy="@Model.ContactValue"
                                data-tip="Copy" aria-label="Copy contact value">
                            <ui-icon name="copy" size="sm" />
                        </button>
                    </div>
                </dd>
            </div>
            <div class="dl__row">
                <dt>Record</dt>
                <dd class="mono">#@Model.Id</dd>
            </div>
        </dl>
    </section>

    <div class="dash-grid">
        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Audit trail</h2>
            </header>
            <dl class="dl">
                <div class="dl__row">
                    <dt>Created by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Created on</dt>
                    <dd>@Display.Stamp(Model.CreatedOn)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.LastModifiedBy) ? "—" : Model.LastModifiedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed on</dt>
                    <dd>@Display.Stamp(Model.LastModifiedOn)</dd>
                </div>
            </dl>
        </section>

        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Danger zone</h2>
            </header>
            @if (Model.IsDeleted)
            {
                <p class="text-sm text-muted mb-3">Restoring puts this channel back on the public contact grid.</p>
                <form asp-action="Restore" asp-route-id="@Model.Id" method="post"
                      data-confirm-title="Restore channel"
                      data-confirm="@($"Put {Model.ContactType} back on the public page?")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--success btn--block" type="submit">
                        <ui-icon name="restore" size="sm" />
                        <span class="btn__label">Restore this channel</span>
                    </button>
                </form>
            }
            else
            {
                <p class="text-sm text-muted mb-3">Archiving hides it from the public contact grid and keeps the row recoverable.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      data-confirm-title="Archive channel"
                      data-confirm="@($"{Model.ContactType} disappears from the public contact grid. You can restore it later.")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--danger btn--block" type="submit">
                        <ui-icon name="del" size="sm" />
                        <span class="btn__label">Archive this channel</span>
                    </button>
                </form>
            }
        </section>
    </div>
</div>
