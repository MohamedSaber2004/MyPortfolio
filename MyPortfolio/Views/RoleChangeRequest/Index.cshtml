@using MyPortfolio.Models.RoleChangeRequestModels
@model List<RoleChangeRequestViewModel>

@{
    ViewData["Title"] = "Role Change Requests";
    var currentStatus = ViewBag.CurrentStatus ?? "Pending";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Role Change Requests</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Tabs -->
    <div class="mb-3">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link @(currentStatus == "Pending" ? "active" : "")" href="@Url.Action("Index", new { status = "Pending" })" role="tab">
                    <i class="bi bi-hourglass-split"></i> Pending
                    <span class="badge bg-warning text-dark ms-2">@Model.Count</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link @(currentStatus == "Approved" ? "active" : "")" href="@Url.Action("Index", new { status = "Approved" })" role="tab">
                    <i class="bi bi-check-circle"></i> Approved
                    <span class="badge bg-success ms-2">@Model.Count</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link @(currentStatus == "Rejected" ? "active" : "")" href="@Url.Action("Index", new { status = "Rejected" })" role="tab">
                    <i class="bi bi-x-circle"></i> Rejected
                    <span class="badge bg-danger ms-2">@Model.Count</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link @(currentStatus == "All" ? "active" : "")" href="@Url.Action("Index", new { status = "All" })" role="tab">
                    <i class="bi bi-list"></i> All History
                </a>
            </li>
        </ul>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No role change requests found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Requested Role</th>
                        <th>Status</th>
                        <th>Requested Date</th>
                        @if (currentStatus != "Pending")
                        {
                            <th>Processed Date</th>
                            <th>Processed By</th>
                        }
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <strong>@request.UserFullName</strong>
                            </td>
                            <td>
                                <a href="mailto:@request.UserEmail">@request.UserEmail</a>
                            </td>
                            <td>
                                <span class="badge bg-primary">@request.RequestedRoleName</span>
                            </td>
                            <td>
                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-hourglass-split"></i> @request.Status
                                    </span>
                                }
                                else if (request.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> @request.Status
                                    </span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle"></i> @request.Status
                                    </span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@request.CreatedOn.ToString("dd MMM yyyy HH:mm")</small>
                            </td>
                            @if (currentStatus != "Pending")
                            {
                                <td>
                                    <small class="text-muted">
                                        @if (request.ProcessedOn.HasValue)
                                        {
                                            @request.ProcessedOn.Value.ToString("dd MMM yyyy HH:mm")
                                        }
                                    </small>
                                </td>
                                <td>
                                    <small>@(request.ProcessedByName ?? "N/A")</small>
                                </td>
                            }
                            <td>
                                <a href="@Url.Action("Details", new { id = request.Id })" class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
