@using MyPortfolio.Models.ExperienceModels
@model IEnumerable<ExperienceViewModel>

@{
    ViewData["Title"] = "Experience";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string? currentSearch = Context?.Request?.Query["experienceSearchName"];
}

<main class="main-content">
    @if (!string.IsNullOrWhiteSpace(TempData["Message"] as string))
    {
        <div aria-live="polite" aria-atomic="true" class="toast-container position-fixed p-3 toast-top-right">
            <div id="successToast" class="toast fade show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-header">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong class="me-auto">Success</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
                <div class="toast-body">
                    @TempData["Message"]
                </div>
            </div>
        </div>
    }

    <div class="page-header mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="page-title">Experience Management</h1>
            <p class="page-subtitle">View, search, and manage experience records.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a class="btn btn-primary" asp-controller="Expereience" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Add New Experience
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 fade-in">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center" autocomplete="off">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input id="experienceSearchName"
                               name="experienceSearchName"
                               class="form-control border-start-0 ps-0"
                               value="@currentSearch"
                               placeholder="Search by company or role..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <button id="searchBtn" type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="experienceTableContainer">
        @if (Model?.Any() ?? false)
        {
            <div class="card shadow-sm border-0 fade-in">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="text-center">
                                <tr>
                                    <th>Company</th>
                                    <th>Role</th>
                                    <th>Dates</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="text-center">
                                @foreach (var exp in Model)
                                {
                                    <tr class="@(exp.IsDeleted ? "table-danger" : "")">
                                        <td class="fw-semibold">@exp.CompanyName</td>
                                        <td>@exp.Role</td>
                                        <td>
                                            <span class="d-block small">@exp.StartDate.ToString("yyyy-MM")</span>
                                            <span class="d-block small text-muted">to</span>
                                            <span class="d-block small">@exp.EndDate.ToString("yyyy-MM")</span>
                                        </td>
                                        <td>
                                            @if (exp.IsDeleted)
                                            {
                                                <span class="badge bg-danger">Deleted</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-1">
                                                <a class="btn btn-sm btn-info"
                                                   asp-action="Details"
                                                   asp-controller="Expereience"
                                                   asp-route-id="@exp.Id"
                                                   title="Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a class="btn btn-sm btn-warning"
                                                   asp-action="Edit"
                                                   asp-controller="Expereience"
                                                   asp-route-id="@exp.Id"
                                                   title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                @if (exp.IsDeleted)
                                                {
                                                    <form asp-action="Restore"
                                                          asp-controller="Expereience"
                                                          asp-route-id="@exp.Id"
                                                          method="post"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-success" title="Restore">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-danger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteModal-@exp.Id"
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </div>

                                            <div class="modal fade"
                                                 id="deleteModal-@exp.Id"
                                                 tabindex="-1"
                                                 aria-labelledby="deleteModalLabel-@exp.Id"
                                                 aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered modal-sm">
                                                    <div class="modal-content border-0">
                                                        <div class="modal-header bg-danger text-white border-0">
                                                            <h5 class="modal-title" id="deleteModalLabel-@exp.Id">
                                                                <i class="bi bi-trash me-2"></i> Delete Experience
                                                            </h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            <p class="mb-0">Are you sure you want to delete <strong>@exp.CompanyName - @exp.Role</strong>?</p>
                                                        </div>
                                                        <div class="modal-footer border-0">
                                                            <form asp-action="Delete"
                                                                  asp-controller="Expereience"
                                                                  asp-route-id="@exp.Id"
                                                                  method="post"
                                                                  class="mt-0">
                                                                @Html.AntiForgeryToken()
                                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-danger">
                                                                    <i class="bi bi-trash me-1"></i> Delete
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 fade-in">
                <div class="card-body">
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-briefcase"></i>
                        </div>
                        <h4>No Experience Records Found</h4>
                        <p>There are no experience records to display. Add a new experience to get started.</p>
                        <a class="btn btn-primary" asp-controller="Expereience" asp-action="Create">
                            <i class="bi bi-plus-lg"></i> Add New Experience
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</main>

@section Scripts {
    <script>
        $(function () {
            var toastEl = document.getElementById('successToast');
            if (toastEl) {
                setTimeout(function () {
                    var toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                    toast.hide();
                }, 5000);
            }

            $('#searchBtn').on('click', function (e) {
                e.preventDefault();
                var searchValue = $('#experienceSearchName').val();
                $.get('@Url.Action("Index", "Expereience")', { experienceSearchName: searchValue }, function (data) {
                    var newTable = $(data).find('#experienceTableContainer').html();
                    $('#experienceTableContainer').html(newTable);
                });
            });
        });
    </script>
}
