@using MyPortfolio.Models.ExperienceModels
@model ExperienceViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit experience";
    ViewData["PageKicker"] = "Experience";
    ViewData["PageTitle"] = "Edit experience";
    ViewData["PageDesc"] = string.IsNullOrWhiteSpace(Model.CompanyName) ? "Update this experience record." : Model.CompanyName;
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
    <a class="btn btn--soft" asp-action="Details" asp-route-id="@Model.Id">
        <ui-icon name="eye" size="sm" />
        <span class="btn__label">Details</span>
    </a>
}

@if (Model.IsDeleted)
{
    <div class="alert alert--warning mb-5">
        <ui-icon name="warn" />
        <div class="alert__body">
            <p class="alert__title">This record is archived</p>
            <p class="alert__text">Saving keeps it off the public page. Use Restore in the list to publish it again.</p>
        </div>
    </div>
}

<section class="card max-w-read">
    <div class="card__bd">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off" novalidate class="form-grid form-grid--2">
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="Id" />

            <div class="field">
                <label asp-for="CompanyName" class="field__label"></label>
                <input asp-for="CompanyName" class="input" />
                <span asp-validation-for="CompanyName"></span>
            </div>

            <div class="field">
                <label asp-for="Role" class="field__label"></label>
                <input asp-for="Role" class="input" />
                <span asp-validation-for="Role"></span>
            </div>

            <div class="field">
                <label asp-for="StartDate" class="field__label"></label>
                <input asp-for="StartDate" class="input" type="date" />
                <span asp-validation-for="StartDate"></span>
            </div>

            <div class="field">
                <label asp-for="EndDate" class="field__label"></label>
                <input asp-for="EndDate" class="input" type="date" />
                <span asp-validation-for="EndDate"></span>
            </div>

            <div class="field form-grid__full">
                <label asp-for="Description" class="field__label"></label>
                <textarea asp-for="Description" class="textarea" rows="4"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="form-foot">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="save" size="sm" />
                    <span class="btn__label">Save changes</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
