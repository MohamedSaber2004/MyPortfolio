@using BusinessLogicLayer.DTos.CvDocumentDTos
@model CvDocumentDto?
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Résumé";
    ViewData["PageKicker"] = "Content";
    ViewData["PageTitle"] = "Résumé";
    ViewData["PageDesc"] = "The PDF behind the full-résumé button on the public page.";
}

<div class="dash-grid dash-grid--split">
    <section class="card panel">
        <header class="panel__hd">
            <h2 class="card__title">Current document</h2>
            <span class="badge badge--@(Model is null ? "warning" : "success")">
                @(Model is null ? "Missing" : "Published")
            </span>
        </header>

        @if (Model is not null)
        {
            var fileHref = Url.Content("~/Files/" + Model.FileName);
            <ul class="list">
                <li class="list__item">
                    <span class="tile tile--danger" aria-hidden="true"><ui-icon name="pdf" size="sm" /></span>
                    <span class="grow min-w-0">
                        <a class="table__primary break-any" href="@fileHref" target="_blank" rel="noopener">@Model.FileName</a>
                        <span class="table__sub">Uploaded @Display.Stamp(Model.UploadedAt) by @Model.UploadedBy</span>
                    </span>
                    <div class="table__actions">
                        <a class="btn btn--icon btn--quiet" href="@fileHref" download
                           data-tip="Download" aria-label="@($"Download {Model.FileName}")">
                            <ui-icon name="download" size="sm" />
                        </a>
                    </div>
                </li>
            </ul>
            <footer class="card__ft">
                <p class="meta">
                    <span class="meta__item mono">#@Model.Id</span>
                    <span class="meta__item">Newest upload wins on the public page</span>
                </p>
            </footer>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyStateVm {
                Title = "No résumé yet",
                Text = "Upload a PDF and the public contact section starts offering it straight away.",
                Icon = "pdf" })" />
        }
    </section>

    <section class="card panel">
        <header class="panel__hd">
            <h2 class="card__title">Upload a new copy</h2>
        </header>
        <div class="card__bd">
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="form-grid">
                <div asp-validation-summary="ModelOnly"></div>

                <div class="field">
                    <label class="field__label" for="CvFile">PDF file</label>
                    <div class="file">
                        <input type="file" id="CvFile" name="CvFile" accept=".pdf,application/pdf" required />
                        <span class="field__hint">PDF only, up to 2 MB. The newest upload is what the public page serves.</span>
                    </div>
                    @if (ViewData.ModelState.TryGetValue("CvFile", out var fileState) && fileState.Errors.Count > 0)
                    {
                        <p class="text-sm text-strong" role="alert">@fileState.Errors[0].ErrorMessage</p>
                    }
                </div>

                <div class="form-foot">
                    <button class="btn btn--primary" type="submit">
                        <ui-icon name="upload" size="sm" />
                        <span class="btn__label">Upload CV</span>
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>
