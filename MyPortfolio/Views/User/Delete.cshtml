@model UserDetailsViewModel
@{
    ViewData["Title"] = "Delete User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="main-content">
    <div class="page-header mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="page-title">Delete User</h1>
            <p class="page-subtitle">Confirm user deletion or restoration.</p>
        </div>
        <a asp-controller="User" asp-action="Index" class="btn btn-ghost">
            <i class="bi bi-arrow-left"></i> Back to list
        </a>
    </div>

    @if (Model.IsDeleted)
    {
        <div class="alert alert-success d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-info-circle-fill fs-5 mt-1"></i>
            <div>
                <strong>Restore available:</strong> This user is currently deleted. You can restore them below.
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
            <div>
                <strong>Warning:</strong> Deleting this user will mark them as deleted. This action can be reversed by restoring the user.
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header">
            <span class="fw-semibold">
                <i class="bi bi-person me-2"></i>User Information
            </span>
        </div>
        <div class="card-body">
            <partial name="UserPartialViews/DetailsDeleteUserPartialView" />
        </div>
    </div>

    <div class="d-flex gap-2">
        @if (Model.IsDeleted)
        {
            <form asp-action="Restore" asp-controller="User" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-arrow-counterclockwise"></i> Restore User
                </button>
            </form>
        }
        else
        {
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteModal-@Model.Id">
                <i class="bi bi-trash"></i> Delete User
            </button>
        }
        <a asp-controller="User" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>

    <div class="modal fade" id="DeleteModal-@Model.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@Model.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteModalLabel-@Model.Id">
                        <i class="bi bi-trash me-2"></i> Confirm Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Are you sure you want to delete this user?</p>
                    <ul class="list-unstyled small mb-0">
                        <li><strong>Name:</strong> @Model.FullName</li>
                        <li><strong>Email:</strong> @Model.Email</li>
                        @if (Model.Roles?.Any() == true)
                        {
                            <li><strong>Roles:</strong> @string.Join(", ", Model.Roles)</li>
                        }
                    </ul>
                </div>
                <div class="modal-footer">
                    <form asp-action="DeleteConfirm" asp-controller="User" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
