@using MyPortfolio.Models.ManagerModels.UserModels
@model UserDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.IsDeleted ? "Restore user" : "Archive user";
    ViewData["PageKicker"] = "Users";
    ViewData["PageTitle"] = Model.IsDeleted ? "Restore this user" : "Archive this user";
    ViewData["PageDesc"] = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Check the record, then confirm."
        : Model.FullName;
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
    <a class="btn btn--soft" asp-action="Details" asp-route-id="@Model.Id">
        <ui-icon name="eye" size="sm" />
        <span class="btn__label">Details</span>
    </a>
}

@if (Model.IsDeleted)
{
    <div class="alert alert--success mb-5">
        <ui-icon name="restore" />
        <div class="alert__body">
            <p class="alert__title">Restore available</p>
            <p class="alert__text">This account is archived. Restoring it hands admin area access back straight away.</p>
        </div>
    </div>
}
else
{
    <div class="alert alert--warning mb-5">
        <ui-icon name="warn" />
        <div class="alert__body">
            <p class="alert__title">Soft delete</p>
            <p class="alert__text">Archiving stops this account from opening the admin area. The record and its content stay recoverable.</p>
        </div>
    </div>
}

<section class="card max-w-lg">
    <div class="card__bd stack">
        <partial name="UserPartialViews/DetailsDeleteUserPartialView" />

        @if (Model.IsDeleted)
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post"
                  data-confirm-title="Restore user"
                  data-confirm="@($"{Model.FullName} gets admin area access again.")">
                @Html.AntiForgeryToken()
                <div class="form-foot">
                    <button class="btn btn--success" type="submit">
                        <ui-icon name="restore" size="sm" />
                        <span class="btn__label">Restore user</span>
                    </button>
                    <a class="btn btn--quiet" asp-action="Index">Cancel</a>
                </div>
            </form>
        }
        else
        {
            <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post"
                  data-confirm-title="Archive user"
                  data-confirm="@($"{Model.FullName} loses access to the admin area. You can restore them later.")">
                @Html.AntiForgeryToken()
                <div class="form-foot">
                    <button class="btn btn--danger" type="submit">
                        <ui-icon name="del" size="sm" />
                        <span class="btn__label">Archive user</span>
                    </button>
                    <a class="btn btn--quiet" asp-action="Index">Cancel</a>
                </div>
            </form>
        }
    </div>
</section>
