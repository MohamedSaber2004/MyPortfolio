@using MyPortfolio.Models.ManagerModels.UserModels
@model UserDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.FullName;
    ViewData["PageKicker"] = "User";
    ViewData["PageTitle"] = Model.FullName;
    ViewData["PageDesc"] = string.IsNullOrWhiteSpace(Model.Email)
        ? "Account record."
        : Model.Email;
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">All users</a>
    <a class="btn btn--primary" asp-action="Edit" asp-route-id="@Model.Id">
        <ui-icon name="edit" size="sm" />
        <span class="btn__label">Edit</span>
    </a>
}

<div class="dash-grid dash-grid--split">
    <section class="card">
        <h2 class="sr-only">User details</h2>
        <partial name="UserPartialViews/DetailsDeleteUserPartialView" />
    </section>

    <div class="dash-grid">
        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Audit trail</h2>
            </header>
            <dl class="dl">
                <div class="dl__row">
                    <dt>Created by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Created on</dt>
                    <dd>@Display.Stamp(Model.CreatedOn)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.LastModifiedBy) ? "—" : Model.LastModifiedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed on</dt>
                    <dd>@Display.Stamp(Model.LastModifiedOn)</dd>
                </div>
            </dl>
        </section>

        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Danger zone</h2>
            </header>
            @if (Model.IsDeleted)
            {
                <form asp-action="Restore" asp-route-id="@Model.Id" method="post"
                      data-confirm-title="Restore user"
                      data-confirm="@($"{Model.FullName} gets admin area access again.")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--success btn--block" type="submit">
                        <ui-icon name="restore" size="sm" />
                        <span class="btn__label">Restore this user</span>
                    </button>
                </form>
            }
            else
            {
                <p class="text-sm text-muted mb-3">Archiving cuts this account off from the admin area and keeps the row recoverable.</p>
                <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post"
                      data-confirm-title="Archive user"
                      data-confirm="@($"{Model.FullName} loses access to the admin area. You can restore them later.")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--danger btn--block" type="submit">
                        <ui-icon name="del" size="sm" />
                        <span class="btn__label">Archive this user</span>
                    </button>
                </form>
            }
        </section>
    </div>
</div>
