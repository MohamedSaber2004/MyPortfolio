@model UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="main-content">
    <div class="page-header mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="page-title">User Details</h1>
            <p class="page-subtitle">Detailed information about this user.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="User" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-controller="User" asp-action="Index" class="btn btn-ghost">
                <i class="bi bi-arrow-left"></i> Back to list
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 fade-in">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">
                <i class="bi bi-person me-2"></i>General Information
            </span>
            <span class="badge @(Model.IsDeleted ? "bg-danger" : "bg-success")">
                @(Model.IsDeleted ? "Deleted" : "Active")
            </span>
        </div>
        <div class="card-body">
            <partial name="UserPartialViews/DetailsDeleteUserPartialView" />
        </div>
    </div>
</main>
