@model UserDetailsViewModel

<div class="row g-4">
    <div class="col-md-6">
        <label class="form-label mb-1">Full name</label>
        <div class="form-control-plaintext border rounded px-3 py-2 bg-body-secondary">@Model.FullName</div>
    </div>

    <div class="col-md-6">
        <label class="form-label mb-1">Email</label>
        <div class="form-control-plaintext border rounded px-3 py-2 bg-body-secondary">@Model.Email</div>
    </div>

    <div class="col-md-6">
        <label class="form-label mb-1">Roles</label>
        @if (Model.Roles?.Any() == true)
        {
            <div class="d-flex flex-wrap gap-1">
                @foreach (var role in Model.Roles)
                {
                    <span class="badge bg-primary">@role</span>
                }
            </div>
            <div class="form-text">Assigned roles (read-only)</div>
        }
        else
        {
            <div class="form-control-plaintext text-muted">No roles</div>
        }
    </div>

    <div class="col-md-6">
        <label class="form-label mb-1">Created by</label>
        <div class="form-control-plaintext border rounded px-3 py-2 bg-body-secondary">@Model.CreatedBy</div>
    </div>

    <div class="col-md-6">
        <label class="form-label mb-1">Last modified by</label>
        <div class="form-control-plaintext border rounded px-3 py-2 bg-body-secondary">
            @(Model.LastModifiedBy ?? "—")
        </div>
    </div>

    <div class="col-md-6">
        <label class="form-label mb-1">Created on</label>
        <div class="form-control-plaintext border rounded px-3 py-2 bg-body-secondary">
            @Model.CreatedOn.ToString("yyyy-MM-dd HH:mm")
        </div>
    </div>

    <div class="col-md-6">
        <label class="form-label mb-1">Last modified on</label>
        <div class="form-control-plaintext border rounded px-3 py-2 bg-body-secondary">
            @(Model.LastModifiedOn?.ToString("yyyy-MM-dd HH:mm") ?? "—")
        </div>
    </div>

    <div class="col-md-6">
        <label class="form-label mb-1">Status</label>
        <div>
            @if (Model.IsDeleted)
            {
                <span class="badge bg-danger">Deleted</span>
            }
            else
            {
                <span class="badge bg-success">Active</span>
            }
        </div>
    </div>
</div>
