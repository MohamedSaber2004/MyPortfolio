@using MyPortfolio.Models.ManagerModels.UserModels
@model UserDetailsViewModel

@* Read-only account summary, shared by User/Details and User/Delete. *@
<dl class="dl">
    <div class="dl__row">
        <dt>Status</dt>
        <dd>
            <span class="badge badge--@(Model.IsDeleted ? "danger" : "success")">
                @(Model.IsDeleted ? "Archived" : "Live")
            </span>
        </dd>
    </div>
    <div class="dl__row">
        <dt>Full name</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.FullName) ? "—" : Model.FullName)</dd>
    </div>
    <div class="dl__row">
        <dt>Email</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</dd>
    </div>
    <div class="dl__row">
        <dt>Roles</dt>
        <dd>
            @if (Model.Roles.Count > 0)
            {
                <ul class="tag-list">
                    @foreach (var role in Model.Roles)
                    {
                        <li><span class="tag">@role</span></li>
                    }
                </ul>
            }
            else
            {
                <span class="text-sm text-faint">No roles assigned</span>
            }
        </dd>
    </div>
    <div class="dl__row">
        <dt>Record</dt>
        <dd class="mono break-any">@Model.Id</dd>
    </div>
</dl>
