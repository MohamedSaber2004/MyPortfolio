@using MyPortfolio.Models.ManagerModels.UserModels
@model UserEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit user";
    ViewData["PageKicker"] = "Users";
    ViewData["PageTitle"] = "Edit user";
    ViewData["PageDesc"] = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Update the account and its role assignments."
        : Model.FullName;
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
    <a class="btn btn--soft" asp-action="Details" asp-route-id="@Model.Id">
        <ui-icon name="eye" size="sm" />
        <span class="btn__label">Details</span>
    </a>
}

<section class="card max-w-lg">
    <div class="card__bd">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate class="form-grid form-grid--2">
            <div asp-validation-summary="ModelOnly" class="form-grid__full"></div>
            <input type="hidden" asp-for="Id" />

            <div class="field">
                <label asp-for="FullName" class="field__label"></label>
                <input asp-for="FullName" class="input" placeholder="Full name" autocomplete="name" />
                <span asp-validation-for="FullName"></span>
            </div>

            <div class="field">
                <label asp-for="Email" class="field__label"></label>
                <input asp-for="Email" class="input" type="email" placeholder="name@example.com" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="field">
                <label asp-for="UserName" class="field__label"></label>
                <input asp-for="UserName" class="input" autocomplete="off" />
                <span class="field__hint">Sign-in handle, kept separate from the email.</span>
                <span asp-validation-for="UserName"></span>
            </div>

            <div class="field form-grid__full">
                <p class="field__label" id="rolesLabel">Roles</p>
                @if (Model.Roles.Count == 0)
                {
                    <span class="field__hint">No roles exist yet — add one under Roles first.</span>
                }
                else
                {
                    <span class="field__hint">Decides which parts of the admin area this account opens.</span>
                    <div class="choice-grid choice-grid--cols" role="group" aria-labelledby="rolesLabel">
                        @for (var i = 0; i < Model.Roles.Count; i++)
                        {
                            <label class="choice">
                                <input type="hidden" asp-for="Roles[@i].RoleName" />
                                <input asp-for="Roles[@i].IsSelected" type="checkbox" />
                                <span class="choice__text">@Model.Roles[i].RoleName</span>
                            </label>
                        }
                    </div>
                }
            </div>

            <div class="form-foot form-grid__full">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="save" size="sm" />
                    <span class="btn__label">Save changes</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
