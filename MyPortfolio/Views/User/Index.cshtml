@using MyPortfolio.Models.ManagerModels.UserModels
@model IEnumerable<UserViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";
    ViewData["PageKicker"] = "Access";
    ViewData["PageTitle"] = "Users";
    ViewData["PageDesc"] = "Every account that can reach the admin area, and what it is allowed to open.";

    var rows = Model?.ToList() ?? [];
    var live = rows.Count(u => !u.IsDeleted);

    static string Initials(string? name)
    {
        var parts = (name ?? string.Empty)
            .Split(new[] { ' ', '.', '_', '-', '@', '(', ')' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0
            ? "?"
            : new string(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])).ToArray());
    }
}

@section PageActions {
    <a class="btn btn--quiet" asp-controller="Role" asp-action="Index">
        <ui-icon name="shield" size="sm" />
        <span class="btn__label">Roles</span>
    </a>
}

<form class="toolbar" asp-action="Index" method="get" autocomplete="off" data-search="#userTable">
    <span class="input-wrap grow">
        <span class="input-wrap__icon"><ui-icon name="search" size="sm" /></span>
        <label class="sr-only" for="searchUserName">Search users</label>
        <input class="input" id="searchUserName" name="SearchUserName" type="search"
               value="@Context.Request.Query["SearchUserName"]" placeholder="Full name…" />
    </span>
    <button class="btn btn--soft" type="submit">
        <ui-icon name="search" size="sm" />
        <span class="btn__label">Search</span>
    </button>
    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["SearchUserName"]))
    {
        <a class="btn btn--quiet" asp-action="Index">Clear</a>
    }
</form>

<div id="userTable">
    @if (rows.Count == 0)
    {
        <div class="card">
            <partial name="_EmptyState" model="@(new EmptyStateVm {
                Title = "No users match",
                Text = "Nobody is registered with that name. Try a shorter term.",
                Icon = "users" })" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack table--sticky">
                <caption class="sr-only">Accounts, in the order they were stored</caption>
                <thead>
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Roles</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="table__num">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in rows)
                    {
                        <tr data-deleted="@(user.IsDeleted ? "true" : "false")">
                            <td data-label="User">
                                <div class="table__main flex gap-3 items-center">
                                    <span class="avatar avatar--sm" aria-hidden="true">@Initials(user.FullName)</span>
                                    <span class="min-w-0">
                                        <a class="table__primary" asp-action="Details" asp-route-id="@user.Id">@user.FullName</a>
                                        <span class="table__sub">@user.Email</span>
                                        @if (!string.IsNullOrWhiteSpace(user.UserName) &&
                                              !string.Equals(user.UserName, user.Email, StringComparison.Ordinal))
                                        {
                                            <span class="table__sub">@user.UserName</span>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td data-label="Roles">
                                @if (user.Roles.Count > 0)
                                {
                                    <ul class="tag-list">
                                        @foreach (var role in user.Roles)
                                        {
                                            <li><span class="tag">@role</span></li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-sm text-faint">No roles</span>
                                }
                            </td>
                            <td data-label="Status">
                                <span class="badge badge--@(user.IsDeleted ? "danger" : "success")">
                                    @(user.IsDeleted ? "Archived" : "Live")
                                </span>
                            </td>
                            <td data-label="Actions">
                                <div class="table__actions">
                                    <a class="btn btn--icon btn--quiet" asp-action="Details" asp-route-id="@user.Id"
                                       data-tip="Details" aria-label="@($"Details for {user.FullName}")">
                                        <ui-icon name="eye" size="sm" />
                                    </a>
                                    <a class="btn btn--icon btn--quiet" asp-action="Edit" asp-route-id="@user.Id"
                                       data-tip="Edit" aria-label="@($"Edit {user.FullName}")">
                                        <ui-icon name="edit" size="sm" />
                                    </a>
                                    @if (user.IsDeleted)
                                    {
                                        <form asp-action="Restore" asp-route-id="@user.Id" method="post"
                                              data-confirm-title="Restore user"
                                              data-confirm="@($"Give {user.FullName} access to the admin area again?")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--success" type="submit"
                                                    data-tip="Restore" aria-label="@($"Restore {user.FullName}")">
                                                <ui-icon name="restore" size="sm" />
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a class="btn btn--icon btn--danger" asp-action="Delete" asp-route-id="@user.Id"
                                           data-tip="Delete" aria-label="@($"Delete {user.FullName}")">
                                            <ui-icon name="del" size="sm" />
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="meta mt-3">
            <span class="meta__item">@live live</span>
            <span class="meta__item">@(rows.Count - live) archived</span>
        </p>
    }
</div>
