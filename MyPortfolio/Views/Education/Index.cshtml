@using MyPortfolio.Models.EducationModels
@model IEnumerable<EducationViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Education";
    ViewData["PageKicker"] = "Content";
    ViewData["PageTitle"] = "Education";
    ViewData["PageDesc"] = "Everything the public Education timeline is built from.";

    var rows = Model?.ToList() ?? [];
    var live = rows.Count(e => !e.IsDeleted);
}

@section PageActions {
    <a class="btn btn--primary" asp-action="Create">
        <ui-icon name="plus" size="sm" />
        <span class="btn__label">New education</span>
    </a>
}

<form class="toolbar" asp-action="Index" method="get" autocomplete="off" data-search="#educationTable">
    <span class="input-wrap grow">
        <span class="input-wrap__icon"><ui-icon name="search" size="sm" /></span>
        <label class="sr-only" for="educationSearchName">Search education</label>
        <input class="input" id="educationSearchName" name="educationSearchName" type="search"
               value="@Context.Request.Query["educationSearchName"]" placeholder="Institution, degree, or field…" />
    </span>
    <button class="btn btn--soft" type="submit">
        <ui-icon name="search" size="sm" />
        <span class="btn__label">Search</span>
    </button>
    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["educationSearchName"]))
    {
        <a class="btn btn--quiet" asp-action="Index">Clear</a>
    }
</form>

<div id="educationTable">
    @if (rows.Count == 0)
    {
        <div class="card">
            <partial name="_EmptyState" model="@(new EmptyStateVm {
                Title = "No education records match",
                Text = "Nothing is shown on the public Education timeline until at least one record exists.",
                Icon = "cap",
                ActionHref = Url.Action("Create", "Education"),
                ActionLabel = "Add the first record" })" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack table--sticky">
                <caption class="sr-only">Education records, as saved</caption>
                <thead>
                    <tr>
                        <th scope="col">Institution</th>
                        <th scope="col">Degree</th>
                        <th scope="col">Field</th>
                        <th scope="col">Period</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="table__num">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in rows)
                    {
                        <tr data-deleted="@(e.IsDeleted ? "true" : "false")">
                            <td data-label="Institution">
                                <div class="table__main">
                                    <a class="table__primary" asp-action="Details" asp-route-id="@e.Id">@e.InstitutionName</a>
                                </div>
                            </td>
                            <td data-label="Degree">@e.Degree</td>
                            <td data-label="Field">@e.FieldOfStudy</td>
                            <td data-label="Period" class="tabular">@Display.Period(e.StartDate, e.EndDate)</td>
                            <td data-label="Status">
                                <span class="badge badge--@(e.IsDeleted ? "danger" : "success")">
                                    @(e.IsDeleted ? "Archived" : "Live")
                                </span>
                            </td>
                            <td data-label="Actions">
                                <div class="table__actions">
                                    <a class="btn btn--icon btn--quiet" asp-action="Details" asp-route-id="@e.Id"
                                       data-tip="Details" aria-label="@($"Details for {e.InstitutionName}")">
                                        <ui-icon name="eye" size="sm" />
                                    </a>
                                    <a class="btn btn--icon btn--quiet" asp-action="Edit" asp-route-id="@e.Id"
                                       data-tip="Edit" aria-label="@($"Edit {e.InstitutionName}")">
                                        <ui-icon name="edit" size="sm" />
                                    </a>
                                    @if (e.IsDeleted)
                                    {
                                        <form asp-action="Restore" asp-route-id="@e.Id" method="post"
                                              data-confirm-title="Restore education"
                                              data-confirm="@($"Put {e.InstitutionName} back on the public timeline?")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--success" type="submit"
                                                    data-tip="Restore" aria-label="@($"Restore {e.InstitutionName}")">
                                                <ui-icon name="restore" size="sm" />
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-route-id="@e.Id" method="post"
                                              data-confirm-title="Archive education"
                                              data-confirm="@($"{e.InstitutionName} — {e.Degree} disappears from the public Education timeline. You can restore it later.")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--danger" type="submit"
                                                    data-tip="Delete" aria-label="@($"Delete {e.InstitutionName}")">
                                                <ui-icon name="del" size="sm" />
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="meta mt-3">
            <span class="meta__item">@live live</span>
            <span class="meta__item">@(rows.Count - live) archived</span>
        </p>
    }
</div>
