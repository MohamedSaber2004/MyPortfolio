@using MyPortfolio.Models.EducationModels
@model EducationViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "New education";
    ViewData["PageKicker"] = "Education";
    ViewData["PageTitle"] = "Add an education record";
    ViewData["PageDesc"] = "It joins the public Education timeline as soon as you save.";
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
}

<section class="card max-w-read">
    <div class="card__bd">
        <form asp-action="Create" method="post" autocomplete="off" novalidate class="form-grid form-grid--2">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="field">
                <label asp-for="InstitutionName" class="field__label"></label>
                <input asp-for="InstitutionName" class="input" placeholder="e.g., University of Example" />
                <span asp-validation-for="InstitutionName"></span>
            </div>

            <div class="field">
                <label asp-for="Degree" class="field__label"></label>
                <input asp-for="Degree" class="input" placeholder="e.g., B.Sc. Computer Science" />
                <span asp-validation-for="Degree"></span>
            </div>

            <div class="field form-grid__full">
                <label asp-for="FieldOfStudy" class="field__label"></label>
                <input asp-for="FieldOfStudy" class="input" placeholder="e.g., Software Engineering" />
                <span asp-validation-for="FieldOfStudy"></span>
            </div>

            <div class="field">
                <label asp-for="StartDate" class="field__label"></label>
                <input asp-for="StartDate" class="input" type="date" />
                <span asp-validation-for="StartDate"></span>
            </div>

            <div class="field">
                <label asp-for="EndDate" class="field__label"></label>
                <input asp-for="EndDate" class="input" type="date" />
                <span asp-validation-for="EndDate"></span>
            </div>

            <div class="field form-grid__full">
                <label asp-for="Description" class="field__label"></label>
                <textarea asp-for="Description" class="textarea" rows="4"
                          placeholder="Optional: summarize coursework, honors, focus areas"></textarea>
                <span class="field__hint">You can leave this empty if not needed.</span>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="form-foot">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="check" size="sm" />
                    <span class="btn__label">Create education</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
