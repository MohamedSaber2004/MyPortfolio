@using BusinessLogicLayer.DTos.EducationDTos
@model EducationDetailsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.InstitutionName;
    ViewData["PageKicker"] = "Education";
    ViewData["PageTitle"] = Model.InstitutionName;
    ViewData["PageDesc"] = string.IsNullOrWhiteSpace(Model.FieldOfStudy)
        ? Model.Degree
        : $"{Model.Degree} · {Model.FieldOfStudy}";
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">All education</a>
    <a class="btn btn--primary" asp-action="Edit" asp-route-id="@Model.Id">
        <ui-icon name="edit" size="sm" />
        <span class="btn__label">Edit</span>
    </a>
}

<div class="dash-grid dash-grid--split">
    <section class="card">
        <h2 class="sr-only">Education details</h2>
        <dl class="dl">
            <div class="dl__row">
                <dt>Status</dt>
                <dd>
                    <span class="badge badge--@(Model.IsDeleted ? "danger" : "success")">
                        @(Model.IsDeleted ? "Archived" : "Live")
                    </span>
                </dd>
            </div>
            <div class="dl__row">
                <dt>Degree</dt>
                <dd>@Model.Degree</dd>
            </div>
            <div class="dl__row">
                <dt>Field of study</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.FieldOfStudy) ? "—" : Model.FieldOfStudy)</dd>
            </div>
            <div class="dl__row">
                <dt>Period</dt>
                <dd class="tabular">@Display.Period(Model.StartDate, Model.EndDate)</dd>
            </div>
            <div class="dl__row">
                <dt>Description</dt>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <dd>@Model.Description</dd>
                }
                else
                {
                    <dd class="text-muted">No description provided.</dd>
                }
            </div>
            <div class="dl__row">
                <dt>Record</dt>
                <dd class="mono">#@Model.Id</dd>
            </div>
        </dl>
    </section>

    <div class="dash-grid">
        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Audit trail</h2>
            </header>
            <dl class="dl">
                <div class="dl__row">
                    <dt>Created by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Created on</dt>
                    <dd>@Display.Stamp(Model.CreatedOn)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.LastModifiedBy) ? "—" : Model.LastModifiedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed on</dt>
                    <dd>@Display.Stamp(Model.LastModifiedOn)</dd>
                </div>
            </dl>
        </section>

        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Danger zone</h2>
            </header>
            @if (Model.IsDeleted)
            {
                <form asp-action="Restore" asp-route-id="@Model.Id" method="post"
                     data-confirm-title="Restore education"
                     data-confirm="@($"Put {Model.InstitutionName} back on the public timeline?")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--success btn--block" type="submit">
                        <ui-icon name="restore" size="sm" />
                        <span class="btn__label">Restore this record</span>
                    </button>
                </form>
            }
            else
            {
                <p class="text-sm text-muted mb-3">Archiving hides it from the public Education timeline and keeps the row recoverable.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                     data-confirm-title="Archive education"
                     data-confirm="@($"{Model.InstitutionName} — {Model.Degree} disappears from the public Education timeline. You can restore it later.")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--danger btn--block" type="submit">
                        <ui-icon name="del" size="sm" />
                        <span class="btn__label">Archive this record</span>
                    </button>
                </form>
            }
        </section>
    </div>
</div>
