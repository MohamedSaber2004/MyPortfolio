@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? Current(string c) => currentController == c ? "page" : null!;
    var identityName = User.Identity?.Name ?? "Admin";
    var initials = new string(identityName
        .Split(new[] { ' ', '.', '_', '-', '@', '(', ')' }, StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(p => char.ToUpperInvariant(p[0])).ToArray());
    var headTitle = ViewData["PageTitle"] as string ?? ViewData["Title"] as string;
    var headSup = ViewData["PageKicker"] as string;
    var headDesc = ViewData["PageDesc"] as string;
    var headOff = ViewData["HidePageHead"] as bool? == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(headTitle is string ht ? ht + " — Admin" : "Admin") - MyPortfolio</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#faf9f5">
    <meta name="color-scheme" content="light">
    <link rel="icon" type="image/svg+xml" href="~/assets/favicon.svg">
    <partial name="_ThemeBoot" />
    <partial name="_Styles" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_Icons" />
    <a class="skip-link" href="#adminMain">Skip to content</a>

    <div class="shell" data-rail="expanded">
        <nav class="rail" id="rail" data-open="false" aria-label="Admin navigation">
            <div class="rail__top">
                <a class="brand" asp-controller="Admin" asp-action="Index">
                    <span class="brand__mark" aria-hidden="true"><ui-icon name="dashboard" size="sm" /></span>
                    <span class="brand__word">Admin</span>
                </a>
            </div>

            <div class="rail__scroll">
                <div class="rail__group">
                    <h2 class="rail__title">Overview</h2>
                    <ul class="rail__list">
                        <li><a class="rail__link" asp-controller="Admin" asp-action="Index" aria-current="@Current("Admin")">
                            <ui-icon name="dashboard" /> <span>Dashboard</span></a></li>
                        <li><a class="rail__link" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">
                            <ui-icon name="external" /> <span>View site</span></a></li>
                    </ul>
                </div>

                <div class="rail__group">
                    <h2 class="rail__title">Content</h2>
                    <ul class="rail__list">
                        <li><a class="rail__link" asp-controller="Project" asp-action="Index" aria-current="@Current("Project")">
                            <ui-icon name="projects" /> <span>Projects</span></a></li>
                        <li><a class="rail__link" asp-controller="Skill" asp-action="Index" aria-current="@Current("Skill")">
                            <ui-icon name="skill" /> <span>Skills</span></a></li>
                        <li><a class="rail__link" asp-controller="Expereience" asp-action="Index" aria-current="@Current("Expereience")">
                            <ui-icon name="briefcase" /> <span>Experience</span></a></li>
                        <li><a class="rail__link" asp-controller="Education" asp-action="Index" aria-current="@Current("Education")">
                            <ui-icon name="cap" /> <span>Education</span></a></li>
                        <li><a class="rail__link" asp-controller="SocialLink" asp-action="Index" aria-current="@Current("SocialLink")">
                            <ui-icon name="share" /> <span>Social links</span></a></li>
                        <li><a class="rail__link" asp-controller="CvDocument" asp-action="Index" aria-current="@Current("CvDocument")">
                            <ui-icon name="pdf" /> <span>Résumé</span></a></li>
                        <li><a class="rail__link" asp-controller="ProfileMedia" asp-action="Index" aria-current="@Current("ProfileMedia")">
                            <ui-icon name="image" /> <span>Portrait</span></a></li>
                    </ul>
                </div>

                <div class="rail__group">
                    <h2 class="rail__title">Inbox</h2>
                    <ul class="rail__list">
                        <li><a class="rail__link" asp-controller="Contact" asp-action="Index" aria-current="@Current("Contact")">
                            <ui-icon name="mail" /> <span>Messages</span></a></li>
                    </ul>
                </div>

                <div class="rail__group">
                    <h2 class="rail__title">Access</h2>
                    <ul class="rail__list">
                        <li><a class="rail__link" asp-controller="User" asp-action="Index" aria-current="@Current("User")">
                            <ui-icon name="users" /> <span>Users</span></a></li>
                        <li><a class="rail__link" asp-controller="Role" asp-action="Index" aria-current="@Current("Role")">
                            <ui-icon name="shield" /> <span>Roles</span></a></li>
                    </ul>
                </div>
            </div>

            <div class="rail__foot">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rail__link">
                        <ui-icon name="logout" /> <span>Log out</span>
                    </button>
                </form>
            </div>
        </nav>

        <div class="main">
            <header class="topbar">
                <button class="btn btn--ghost btn--icon" type="button" data-rail-toggle aria-label="Open navigation">
                    <ui-icon name="rail" size="md" />
                </button>
                <button class="btn btn--ghost btn--icon hide-sm" type="button" data-rail-collapse aria-pressed="false" aria-label="Collapse sidebar">
                    <ui-icon name="chevR" size="md" />
                </button>
                <span class="topbar__title truncate">@headTitle</span>
                <div class="topbar__tools">
                    <button class="theme-btn" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch colour theme">
                        <ui-icon name="moon" size="sm" class="icon-moon" />
                        <ui-icon name="sun" size="sm" class="icon-sun" />
                    </button>
                    <div class="menu" data-open="false">
                        <button class="btn btn--quiet btn--sm" type="button" data-menu-toggle aria-expanded="false" aria-haspopup="true">
                            <span class="avatar avatar--sm" aria-hidden="true">@initials</span>
                            <span class="hide-sm">@identityName</span>
                            <ui-icon name="chevD" size="sm" />
                        </button>
                        <ul class="menu__panel" role="menu">
                            <li><a class="menu__item" role="menuitem" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">
                                <ui-icon name="external" size="sm" /> Public site</a></li>
                            <li><a class="menu__item" role="menuitem" asp-controller="Admin" asp-action="Index">
                                <ui-icon name="dashboard" size="sm" /> Dashboard</a></li>
                            <li class="menu__sep" role="separator"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="menu__item menu__item--danger" role="menuitem">
                                        <ui-icon name="logout" size="sm" /> Log out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="canvas" id="adminMain">
                @if (!headOff && !string.IsNullOrWhiteSpace(headTitle))
                {
                    <header class="page-head" data-reveal>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(headSup))
                            {
                                <p class="eyebrow eyebrow--accent">@headSup</p>
                            }
                            <h1 class="page-head__title">@headTitle</h1>
                            @if (!string.IsNullOrWhiteSpace(headDesc))
                            {
                                <p class="page-head__sub">@headDesc</p>
                            }
                        </div>
                        <div class="page-head__tools">
                            @await RenderSectionAsync("PageActions", required: false)
                        </div>
                    </header>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="scrim" id="railScrim" data-open="false"></div>

    <partial name="_Flash" />
    <partial name="_ConfirmDialog" />
    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
