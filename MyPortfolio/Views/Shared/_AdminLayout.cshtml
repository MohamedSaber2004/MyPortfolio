<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - MyPortfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/css/site.css" asp-append-version="true" />
    <link href="~/css/adminHome.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <div class="gradient-bar"></div>

    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <div class="p-3 d-flex align-items-center gap-2 border-bottom border-secondary">
            <i class="bi bi-speedometer2 fs-4 text-primary"></i>
            <span class="fw-bold gradient-text">Admin Panel</span>
        </div>
        <div class="sidebar-content mt-2">
            <div class="nav-section">
                <div class="nav-section-title small text-uppercase px-3 py-2 text-muted fw-semibold">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Main</span>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-house-door nav-icon"></i>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-section mt-3">
                <div class="nav-section-title small text-uppercase px-3 py-2 text-muted fw-semibold">
                    <i class="bi bi-gear"></i>
                    <span>Management</span>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house nav-icon"></i>
                            <span class="nav-text">Home</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="Index">
                            <i class="bi bi-people nav-icon"></i>
                            <span class="nav-text">Users</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Role" asp-action="Index">
                            <i class="bi bi-shield-lock nav-icon"></i>
                            <span class="nav-text">Roles</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Project" asp-action="Index">
                            <i class="bi bi-folder nav-icon"></i>
                            <span class="nav-text">Projects</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Contact" asp-action="Index">
                            <i class="bi bi-file-earmark-text nav-icon"></i>
                            <span class="nav-text">Contacts</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Education" asp-action="Index">
                            <i class="bi bi-mortarboard nav-icon"></i>
                            <span class="nav-text">Education</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Expereience" asp-action="Index">
                            <i class="bi bi-briefcase nav-icon"></i>
                            <span class="nav-text">Experience</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SocialLink" asp-action="Index">
                            <i class="bi bi-share nav-icon"></i>
                            <span class="nav-text">Social Links</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Skill" asp-action="Index">
                            <i class="bi bi-lightning-charge nav-icon"></i>
                            <span class="nav-text">Skills</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-section mt-3 border-top border-secondary pt-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-link btn btn-link text-danger w-100 text-start px-3 py-2">
                                <i class="bi bi-box-arrow-right nav-icon"></i>
                                <span class="nav-text">Logout</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <header class="admin-header">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-ghost btn-sm p-1" id="sidebarToggle">
                <i class="bi bi-list fs-5"></i>
            </button>
            <button id="themeToggle" class="theme-toggle-btn" type="button" aria-label="Toggle theme">
                <i class="bi bi-moon-stars" id="themeIcon"></i>
            </button>
        </div>
        <div class="ms-auto d-flex align-items-center gap-2">
            <div class="search-box d-none d-md-block">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search...">
            </div>
            <div class="profile-dropdown">
                <div class="profile-avatar">
                    @(User?.Identity?.Name?.Substring(0, Math.Min(2, User?.Identity?.Name?.Length ?? 1))?.ToUpper() ?? "A")
                </div>
            </div>
        </div>
    </header>

    <div>
        @RenderBody()
    </div>

    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
