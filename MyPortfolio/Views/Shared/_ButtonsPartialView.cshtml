@model object

<td class="text-center">
    <div class="d-flex justify-content-center gap-1">
        <a class="btn btn-sm btn-ghost" asp-action="Details" asp-route-id="@Model" title="Details">
            <i class="bi bi-eye"></i>
        </a>
        <a class="btn btn-sm btn-ghost" asp-action="Edit" asp-route-id="@Model" title="Edit">
            <i class="bi bi-pencil"></i>
        </a>
    </div>
</td>