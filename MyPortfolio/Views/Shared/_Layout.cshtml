@using BusinessLogicLayer.Services.Interfaces
@inject ICvDocumentService CvDocumentService
@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool isAdmin = User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
    bool isAuthenticated = User?.Identity?.IsAuthenticated == true;
    string NavActive(string c, string? a = null) =>
        currentController == c && (a == null || currentAction == a) ? "active fw-semibold" : "";
    var cvFileName = System.Threading.Tasks.Task.Run(async () => await CvDocumentService.GetCvFileNameAsync()).GetAwaiter().GetResult();
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MyPortfolio</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 300'%3E%3Cdefs%3E%3ClinearGradient id='grad1' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' style='stop-color:%238b5cf6;stop-opacity:1' /%3E%3Cstop offset='50%25' style='stop-color:%236366f1;stop-opacity:1' /%3E%3Cstop offset='100%25' style='stop-color:%234f46e5;stop-opacity:1' /%3E%3C/linearGradient%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyPortfolio.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <div class="gradient-bar"></div>
    <header>
        <nav class="navbar navbar-expand-md main-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary rounded-circle p-2">
                        <i class="bi bi-stack text-white"></i>
                    </span>
                    <span class="gradient-text">MyPortfolio</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Home","Index")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Admin","Index")" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Admin
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">
                                <i class="bi bi-person"></i> About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="skills">
                                <i class="bi bi-lightning-charge"></i> Skills
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="projects">
                                <i class="bi bi-kanban"></i> Projects
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="social">
                                <i class="bi bi-share"></i> Social
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="contact">
                                <i class="bi bi-envelope-at"></i> Contact
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <button id="themeToggle" class="theme-toggle-btn" type="button"
                                aria-label="Toggle theme" title="Toggle light/dark">
                            <i class="bi bi-moon-stars" id="themeIcon"></i>
                        </button>

                        @if (isAuthenticated)
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-ghost btn-sm px-3">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus"></i> Register
                            </a>
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer mt-auto pt-5 pb-3">
        <div class="container">
            <div class="row g-4 pb-4">
                <div class="col-12 col-md-4">
                    <h6 class="fw-semibold d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-primary rounded-circle p-1 dot-indicator" aria-hidden="true"></span>
                        <span class="gradient-text">MyPortfolio</span>
                    </h6>
                    <p class="small text-muted mb-3">
                        Showcasing projects, experience, education, and skills. Built with ASP.NET Core, Bootstrap, and a modern theme.
                    </p>
                    <a href="mailto:dev.mohamed104saber@gmail.com" class="btn btn-outline-primary btn-sm rounded-pill">
                        <i class="bi bi-envelope-at"></i> Email Me
                    </a>
                </div>

                <div class="col-6 col-md-2">
                    <h6 class="text-uppercase small fw-semibold mb-3 text-muted">Navigate</h6>
                    <ul class="list-unstyled small footer-links">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right"></i> Home</a></li>
                        @if (isAdmin)
                        {
                            <li><a asp-controller="Admin" asp-action="Index"><i class="bi bi-chevron-right"></i> Admin</a></li>
                        }
                        <li><a href="#top" class="back-to-top-link"><i class="bi bi-chevron-up"></i> Back to Top</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3">
                    <h6 class="text-uppercase small fw-semibold mb-3 text-muted">Contact</h6>
                    <ul class="list-unstyled small footer-links">
                        <li><a href="mailto:dev.mohamed104saber@gmail.com"><i class="bi bi-envelope"></i> Email</a></li>
                        <li><a href="https://www.linkedin.com/in/mohamed-saber107/" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i> LinkedIn</a></li>
                        <li><a href="https://github.com/MohamedSaber2004" target="_blank" rel="noopener"><i class="bi bi-github"></i> GitHub</a></li>
                        <li><a href="~/Files/@(cvFileName ?? "CV.pdf")" target="_blank" rel="noopener"><i class="bi bi-file-earmark-person"></i> Résumé</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-3">
                    <h6 class="text-uppercase small fw-semibold mb-3 text-muted">Follow</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="social-icon-link" href="https://github.com/MohamedSaber2004" aria-label="GitHub" target="_blank" rel="noopener"><i class="bi bi-github"></i></a>
                        <a class="social-icon-link" href="https://www.linkedin.com/in/mohamed-saber107/" aria-label="LinkedIn" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i></a>
                        <a class="social-icon-link" href="mailto:dev.mohamed104saber@gmail.com" aria-label="Email"><i class="bi bi-envelope-fill"></i></a>
                    </div>
                    <div class="mt-3">
                        <button id="footerThemeToggle" type="button" class="btn btn-outline-secondary btn-sm rounded-pill">
                            <i class="bi bi-circle-half"></i> Theme
                        </button>
                    </div>
                </div>
            </div>

            <hr class="border-secondary my-3" />

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <span>&copy; @DateTime.UtcNow.Year MyPortfolio. All rights reserved.</span>
                <span><i class="bi bi-clock-history"></i> UTC @DateTime.Now</span>
            </div>
        </div>
    </footer>

    <!-- Scroll to top -->
    <button id="scrollTopBtn" aria-label="Scroll to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
