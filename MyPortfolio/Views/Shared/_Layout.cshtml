@using BusinessLogicLayer.Services.Interfaces
@inject ICvDocumentService CvDocumentService
@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    bool isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    string Current(string c) => currentController == c ? "page" : null!;
    var cvFileName = await CvDocumentService.GetCvFileNameAsync();
    var metaDescription = ViewData["MetaDescription"] as string
        ?? "Portfolio of Mohamed Saber — full stack .NET developer: projects, experience, education and skills.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string t ? t + " — MyPortfolio" : "MyPortfolio")</title>
    <meta name="description" content="@metaDescription">
    <meta name="theme-color" content="#faf9f5">
    <meta name="color-scheme" content="light">
    <meta property="og:title" content="@(ViewData["Title"] is string t2 ? t2 : "MyPortfolio")">
    <meta property="og:description" content="@metaDescription">
    <meta property="og:type" content="website">
    <link rel="icon" type="image/svg+xml" href="~/assets/favicon.svg">
    <partial name="_ThemeBoot" />
    <partial name="_Styles" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_Icons" />
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="site-shell">
        <header class="nav-bar">
            <div class="container nav-bar__inner">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand__mark" aria-hidden="true"><ui-icon name="code" size="sm" /></span>
                    <span class="brand__word">MyPortfolio</span>
                </a>

                <ul class="nav-links" id="siteNavLinks" data-open="false">
                    <li><a class="nav-item" asp-controller="Home" asp-action="Index" aria-current="@Current("Home")">Home</a></li>
                    <li><a class="nav-item" asp-controller="Home" asp-action="Index" asp-fragment="about">About</a></li>
                    <li><a class="nav-item" asp-controller="Home" asp-action="Index" asp-fragment="skills">Skills</a></li>
                    <li><a class="nav-item" asp-controller="Home" asp-action="Index" asp-fragment="experience">Experience</a></li>
                    <li><a class="nav-item" asp-controller="Home" asp-action="Index" asp-fragment="projects">Work</a></li>
                    <li><a class="nav-item" asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact</a></li>
                    @if (isAdmin)
                    {
                        <li><a class="nav-item" asp-controller="Admin" asp-action="Index" aria-current="@Current("Admin")">
                            <ui-icon name="dashboard" size="sm" /> Admin
                        </a></li>
                    }
                </ul>

                <div class="nav-tools">
                    <button class="theme-btn" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch colour theme">
                        <ui-icon name="moon" size="sm" class="icon-moon" />
                        <ui-icon name="sun" size="sm" class="icon-sun" />
                    </button>
                    @if (isAuthenticated)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn--ghost btn--sm">
                                <ui-icon name="logout" size="sm" /> Log out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn--ghost btn--sm hide-sm" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn--primary btn--sm" asp-controller="Account" asp-action="Register">
                            <ui-icon name="user" size="sm" /> Register
                        </a>
                    }
                    <button class="nav-toggle" type="button" data-nav-toggle aria-controls="siteNavLinks" aria-expanded="false" aria-label="Toggle navigation">
                        <ui-icon name="menu" size="md" />
                    </button>
                </div>
            </div>
        </header>

        <main id="main">
            @RenderBody()
        </main>

        <footer class="site-footer">
            <div class="container">
                <div class="footer-grid">
                    <div>
                        <a class="brand" asp-controller="Home" asp-action="Index">
                            <span class="brand__mark" aria-hidden="true"><ui-icon name="code" size="sm" /></span>
                            <span class="brand__word">MyPortfolio</span>
                        </a>
                        <p class="footer__lede">
                            Projects, experience, education and skills — built with ASP.NET Core on a hand-written design system.
                        </p>
                        <a class="btn btn--outline btn--sm" href="mailto:dev.mohamed104saber@gmail.com">
                            <ui-icon name="mail" size="sm" /> Email me
                        </a>
                    </div>

                    <div>
                        <h6 class="footer__title">Navigate</h6>
                        <ul class="footer__list">
                            <li><a class="footer__link" asp-controller="Home" asp-action="Index"><ui-icon name="chevR" size="sm" /> Home</a></li>
                            <li><a class="footer__link" asp-controller="Home" asp-action="Index" asp-fragment="projects"><ui-icon name="chevR" size="sm" /> Work</a></li>
                            <li><a class="footer__link" asp-controller="Home" asp-action="Index" asp-fragment="contact"><ui-icon name="chevR" size="sm" /> Contact</a></li>
                            @if (isAdmin)
                            {
                                <li><a class="footer__link" asp-controller="Admin" asp-action="Index"><ui-icon name="chevR" size="sm" /> Admin</a></li>
                            }
                        </ul>
                    </div>

                    <div>
                        <h6 class="footer__title">Documents</h6>
                        <ul class="footer__list">
                            <li><a class="footer__link" href="~/Files/@(cvFileName ?? "CV.pdf")" target="_blank" rel="noopener"><ui-icon name="pdf" size="sm" /> Résumé (PDF)</a></li>
                            <li><a class="footer__link" asp-controller="Home" asp-action="Privacy"><ui-icon name="shield" size="sm" /> Privacy policy</a></li>
                        </ul>
                    </div>

                    <div>
                        <h6 class="footer__title">Elsewhere</h6>
                        <div class="social-row">
                            <a class="social" href="https://github.com/MohamedSaber2004" target="_blank" rel="noopener" aria-label="GitHub"><ui-icon name="github" size="sm" /></a>
                            <a class="social" href="https://www.linkedin.com/in/mohamed-saber107/" target="_blank" rel="noopener" aria-label="LinkedIn"><ui-icon name="linkedin" size="sm" /></a>
                            <a class="social" href="mailto:dev.mohamed104saber@gmail.com" aria-label="Email"><ui-icon name="mail" size="sm" /></a>
                        </div>
                    </div>
                </div>

                <div class="footer-bottom">
                    <span>&copy; @DateTime.UtcNow.Year MyPortfolio. All rights reserved.</span>
                    <button class="theme-btn" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch colour theme">
                        <ui-icon name="moon" size="sm" class="icon-moon" />
                        <ui-icon name="sun" size="sm" class="icon-sun" />
                    </button>
                </div>
            </div>
        </footer>
    </div>

    <button class="scrolltop" type="button" data-visible="false" aria-label="Scroll back to top">
        <ui-icon name="arrowUp" size="md" />
    </button>

    <partial name="_Flash" />
    <partial name="_ConfirmDialog" />
    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
