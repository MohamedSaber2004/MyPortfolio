@{
    var title = ViewData["Title"] as string ?? "Account";
    var wide = ViewData["WidePanel"] as bool? == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title - MyPortfolio</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#faf9f5">
    <meta name="color-scheme" content="light">
    <link rel="icon" type="image/svg+xml" href="~/assets/favicon.svg">
    <partial name="_ThemeBoot" />
    <partial name="_Styles" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_Icons" />
    <div class="auth">
        <main class="auth__panel @(wide ? "auth__panel--wide" : null)">
            <div class="flex items-center justify-between gap-4">
                <a class="auth__brand" asp-controller="Home" asp-action="Index">
                    <span class="brand__mark" aria-hidden="true"><ui-icon name="code" size="sm" /></span>
                    MyPortfolio
                </a>
                <button class="theme-btn" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch colour theme">
                    <ui-icon name="moon" size="sm" class="icon-moon" />
                    <ui-icon name="sun" size="sm" class="icon-sun" />
                </button>
            </div>
            @RenderBody()
        </main>
    </div>

    <partial name="_Flash" />
    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
