@model ErrorViewModel
@{
    var error = Model ?? new ErrorViewModel();
    var status = error.StatusCode ?? 500;
    ViewData["Title"] = status == 404 ? "Page not found" : "Error";
    ViewData["MetaDescription"] = "Something went wrong on the way to this page.";
}

<div class="stopper">
    <span class="stopper__code">@status</span>
    <span class="tile tile--danger tile--lg">
        <ui-icon name="@(status == 404 ? "close" : "warn")" />
    </span>
    <h1 class="text-2xl">@error.Headline</h1>
    <p class="text-muted max-w-prose">@error.Blurb</p>

    <div class="flex gap-3 wrap justify-center mt-4">
        <a class="btn btn--primary" asp-controller="Home" asp-action="Index">
            <ui-icon name="home" size="sm" />
            <span class="btn__label">Back to the portfolio</span>
        </a>
        <a class="btn btn--outline" asp-controller="Home" asp-action="Privacy">Privacy note</a>
    </div>
</div>
