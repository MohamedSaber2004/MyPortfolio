@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center p-4" style="background: var(--bg-secondary);">
    <div class="card shadow-lg border-0 fade-in" style="max-width: 520px; width: 100%;">
        <div class="card-body text-center p-5">
            <div class="d-inline-flex align-items-center justify-content-center rounded-4 p-3 mb-4 bg-danger-subtle">
                <i class="bi bi-exclamation-triangle text-danger fs-1"></i>
            </div>
            <h2 class="fw-bold mb-2">Something went wrong</h2>
            <p class="text-muted mb-4">An unexpected error occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 mb-4 small" style="background: var(--bg-tertiary);">
                    <span class="text-muted">Request ID:</span>
                    <code class="fw-semibold">@Model.RequestId</code>
                </div>
            }

            <hr class="my-4" />
            <p class="small text-muted mb-4">
                <strong>Development Mode</strong><br />
                Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
            </p>
            <a href="/" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-house-door"></i> Back to Home
            </a>
        </div>
    </div>
</div>