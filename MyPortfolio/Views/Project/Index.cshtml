@using MyPortfolio.Models.ProjectModels
@model IEnumerable<ProjectViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Projects";
    ViewData["PageKicker"] = "Content";
    ViewData["PageTitle"] = "Projects";
    ViewData["PageDesc"] = "Everything the landing Selected work grid is built from.";

    var rows = Model?.ToList() ?? [];
    var live = rows.Count(p => !p.IsDeleted);
}

@section PageActions {
    <a class="btn btn--primary" asp-action="Create">
        <ui-icon name="plus" size="sm" />
        <span class="btn__label">New project</span>
    </a>
}

<form class="toolbar" asp-action="Index" method="get" autocomplete="off" data-search="#projectTable">
    <span class="input-wrap grow">
        <span class="input-wrap__icon"><ui-icon name="search" size="sm" /></span>
        <label class="sr-only" for="projectSearchName">Search projects</label>
        <input class="input" id="projectSearchName" name="projectSearchName" type="search"
               value="@Context.Request.Query["projectSearchName"]" placeholder="Title or description…" />
    </span>
    <button class="btn btn--soft" type="submit">
        <ui-icon name="search" size="sm" />
        <span class="btn__label">Search</span>
    </button>
    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["projectSearchName"]))
    {
        <a class="btn btn--quiet" asp-action="Index">Clear</a>
    }
</form>

<div id="projectTable">
    @if (rows.Count == 0)
    {
        <div class="card">
            <partial name="_EmptyState" model="@(new EmptyStateVm {
                Title = "No projects match",
                Text = "Nothing is shown on the public Selected work grid until at least one project exists.",
                Icon = "projects",
                ActionHref = Url.Action("Create", "Project"),
                ActionLabel = "Add the first project" })" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack table--sticky">
                <caption class="sr-only">Projects, newest first as saved</caption>
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col">Period</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="table__num">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in rows)
                    {
                        var cover = CoverSrc(project.ExistingProjectImage);
                        var sub = Clip(project.Description);
                        <tr data-deleted="@(project.IsDeleted ? "true" : "false")">
                            <td data-label="Project">
                                <div class="flex items-center gap-3">
                                    <span class="tile tile--lg">
                                        @if (cover.Length > 0)
                                        {
                                            <img src="@cover" alt="" loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <ui-icon name="image" size="sm" />
                                        }
                                    </span>
                                    <div class="table__main min-w-0">
                                        <a class="table__primary" asp-action="Details" asp-route-id="@project.Id">@project.Title</a>
                                        @if (sub.Length > 0)
                                        {
                                            <span class="table__sub">@sub</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td data-label="Period">@Display.Period(project.StartDate, project.EndDate)</td>
                            <td data-label="Status">
                                <span class="badge badge--@(project.IsDeleted ? "danger" : "success")">
                                    @(project.IsDeleted ? "Archived" : "Live")
                                </span>
                            </td>
                            <td data-label="Actions">
                                <div class="table__actions">
                                    <a class="btn btn--icon btn--quiet" asp-action="Details" asp-route-id="@project.Id"
                                       data-tip="Details" aria-label="@($"Details for {project.Title}")">
                                        <ui-icon name="eye" size="sm" />
                                    </a>
                                    <a class="btn btn--icon btn--quiet" asp-action="Edit" asp-route-id="@project.Id"
                                       data-tip="Edit" aria-label="@($"Edit {project.Title}")">
                                        <ui-icon name="edit" size="sm" />
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(project.ProjectURL))
                                    {
                                        <a class="btn btn--icon btn--quiet" href="@project.ProjectURL"
                                           target="_blank" rel="noopener"
                                           data-tip="Open site" aria-label="@($"Open {project.Title} in a new tab")">
                                            <ui-icon name="external" size="sm" />
                                        </a>
                                    }
                                    @if (project.IsDeleted)
                                    {
                                        <form asp-action="Restore" asp-route-id="@project.Id" method="post"
                                              data-confirm-title="Restore project"
                                              data-confirm="@($"Put {project.Title} back on the public page?")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--success" type="submit"
                                                    data-tip="Restore" aria-label="@($"Restore {project.Title}")">
                                                <ui-icon name="restore" size="sm" />
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-route-id="@project.Id" method="post"
                                              data-confirm-title="Archive project"
                                              data-confirm="@($"{project.Title} disappears from the public Selected work grid. You can restore it later.")">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn--icon btn--danger" type="submit"
                                                    data-tip="Delete" aria-label="@($"Delete {project.Title}")">
                                                <ui-icon name="del" size="sm" />
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="meta mt-3">
            <span class="meta__item">@live live</span>
            <span class="meta__item">@(rows.Count - live) archived</span>
        </p>
    }
</div>

@functions {
    static string CoverSrc(string? file) => string.IsNullOrWhiteSpace(file)
        ? string.Empty
        : $"/Files/Images/Projects/{Uri.EscapeDataString(file.Trim())}";

    static string Clip(string? text)
    {
        var flat = string.IsNullOrWhiteSpace(text)
            ? string.Empty
            : string.Join(' ', text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return flat.Length > 100 ? flat[..100] + "…" : flat;
    }
}
