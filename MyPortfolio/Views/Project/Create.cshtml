@using MyPortfolio.Models.ProjectModels
@model ProjectViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "New project";
    ViewData["PageKicker"] = "Projects";
    ViewData["PageTitle"] = "Add a project";
    ViewData["PageDesc"] = "It joins the public Selected work grid as soon as you save.";
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
}

<section class="card">
    <div class="card__bd">
        <form asp-action="Create" method="post" enctype="multipart/form-data" autocomplete="off" novalidate>
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-grid form-grid--2">
                <div class="field">
                    <label asp-for="Title" class="field__label"></label>
                    <input asp-for="Title" class="input" placeholder="e.g. MyPortfolio CMS" autocomplete="off" />
                    <span asp-validation-for="Title"></span>
                </div>

                <div class="field">
                    <label asp-for="ProjectURL" class="field__label"></label>
                    <input asp-for="ProjectURL" class="input" type="url" inputmode="url"
                           placeholder="https://…" autocomplete="off" />
                    <span asp-validation-for="ProjectURL"></span>
                </div>

                <div class="field form-grid__full">
                    <label asp-for="Description" class="field__label"></label>
                    <textarea asp-for="Description" class="textarea" rows="5"
                              placeholder="What it does, what it runs on, what you owned."></textarea>
                    <span class="field__hint">Each line becomes a paragraph on the public page.</span>
                    <span asp-validation-for="Description"></span>
                </div>

                <div class="field">
                    <label asp-for="StartDate" class="field__label"></label>
                    <input asp-for="StartDate" class="input" type="date" />
                    <span asp-validation-for="StartDate"></span>
                </div>

                <div class="field">
                    <label asp-for="EndDate" class="field__label"></label>
                    <input asp-for="EndDate" class="input" type="date" />
                    <span asp-validation-for="EndDate"></span>
                </div>

                <div class="field form-grid__full">
                    <label asp-for="ProjectImage" class="field__label"></label>
                    <div class="file" data-preview="#projectPreview">
                        <input asp-for="ProjectImage" class="input" type="file" accept="image/*"
                               data-preview="#projectPreview" />
                    </div>
                    <img class="preview" id="projectPreview" alt="" hidden />
                    <span class="field__hint">Optional cover, shown at 16:9. JPG, JPEG, PNG, WEBP or GIF.</span>
                    <span asp-validation-for="ProjectImage"></span>
                </div>
            </div>

            <div class="form-foot">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="check" size="sm" />
                    <span class="btn__label">Create project</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
