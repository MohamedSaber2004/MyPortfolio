@using BusinessLogicLayer.DTos.ProjectDTos
@model ProjectDetailsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Title;
    ViewData["PageKicker"] = "Project";
    ViewData["PageTitle"] = Model.Title;
    ViewData["PageDesc"] = Display.Period(Model.StartDate, Model.EndDate);

    var cover = string.IsNullOrWhiteSpace(Model.ProjectImage)
        ? string.Empty
        : $"/Files/Images/Projects/{Uri.EscapeDataString(Model.ProjectImage.Trim())}";
    var site = Model.ProjectURL?.Trim() ?? string.Empty;
    var lines = DescriptionLines(Model.Description).ToList();
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">All projects</a>
    <a class="btn btn--primary" asp-action="Edit" asp-route-id="@Model.Id">
        <ui-icon name="edit" size="sm" />
        <span class="btn__label">Edit</span>
    </a>
}

<div class="dash-grid dash-grid--split">
    <section class="card">
        @if (cover.Length > 0)
        {
            <figure class="card__media">
                <img src="@cover" alt="@Model.Title" loading="lazy" decoding="async" />
            </figure>
        }
        <h2 class="sr-only">Project details</h2>
        @if (lines.Count > 0)
        {
            <div class="card__bd">
                <div class="stack gap-2">
                    @foreach (var line in lines)
                    {
                        <p class="text-sm text-muted">@line</p>
                    }
                </div>
            </div>
        }
        <dl class="dl">
            <div class="dl__row">
                <dt>Status</dt>
                <dd>
                    <span class="badge badge--@(Model.IsDeleted ? "danger" : "success")">
                        @(Model.IsDeleted ? "Archived" : "Live")
                    </span>
                </dd>
            </div>
            <div class="dl__row">
                <dt>Period</dt>
                <dd>@Display.Period(Model.StartDate, Model.EndDate)</dd>
            </div>
            <div class="dl__row">
                <dt>Site</dt>
                <dd>
                    @if (site.Length > 0)
                    {
                        <a href="@site" target="_blank" rel="noopener">@site<ui-icon name="external" size="sm" /></a>
                    }
                    else
                    {
                        <text>—</text>
                    }
                </dd>
            </div>
            <div class="dl__row">
                <dt>Cover file</dt>
                <dd class="mono break-any">@(string.IsNullOrWhiteSpace(Model.ProjectImage) ? "—" : Model.ProjectImage)</dd>
            </div>
            <div class="dl__row">
                <dt>Record</dt>
                <dd class="mono">#@Model.Id</dd>
            </div>
        </dl>
    </section>

    <div class="dash-grid">
        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Audit trail</h2>
            </header>
            <dl class="dl">
                <div class="dl__row">
                    <dt>Created by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Created on</dt>
                    <dd>@Display.Stamp(Model.CreatedOn)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed by</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.LastModifiedBy) ? "—" : Model.LastModifiedBy)</dd>
                </div>
                <div class="dl__row">
                    <dt>Changed on</dt>
                    <dd>@Display.Stamp(Model.LastModifiedOn)</dd>
                </div>
            </dl>
        </section>

        <section class="card panel">
            <header class="panel__hd">
                <h2 class="card__title">Danger zone</h2>
            </header>
            @if (Model.IsDeleted)
            {
                <form asp-action="Restore" asp-route-id="@Model.Id" method="post"
                     data-confirm-title="Restore project"
                     data-confirm="@($"Put {Model.Title} back on the public page?")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--success btn--block" type="submit">
                        <ui-icon name="restore" size="sm" />
                        <span class="btn__label">Restore this project</span>
                    </button>
                </form>
            }
            else
            {
                <p class="text-sm text-muted mb-3">Archiving hides it from the public Selected work grid and keeps the row recoverable.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                     data-confirm-title="Archive project"
                     data-confirm="@($"{Model.Title} disappears from the public Selected work grid. You can restore it later.")">
                    @Html.AntiForgeryToken()
                    <button class="btn btn--danger btn--block" type="submit">
                        <ui-icon name="del" size="sm" />
                        <span class="btn__label">Archive this project</span>
                    </button>
                </form>
            }
        </section>
    </div>
</div>

@functions {
    static IEnumerable<string> DescriptionLines(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) yield break;
        foreach (var line in text.Replace("\r\n", "\n")
                                 .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            yield return line;
        }
    }
}
