@using MyPortfolio.Models.ProjectModels
@model ProjectViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit project";
    ViewData["PageKicker"] = "Projects";
    ViewData["PageTitle"] = "Edit project";
    ViewData["PageDesc"] = string.IsNullOrWhiteSpace(Model.Title) ? "Update this project." : Model.Title;

    var cover = CoverSrc(Model.ExistingProjectImage);
}

@section PageActions {
    <a class="btn btn--quiet" asp-action="Index">Back to list</a>
    <a class="btn btn--soft" asp-action="Details" asp-route-id="@Model.Id">
        <ui-icon name="eye" size="sm" />
        <span class="btn__label">Details</span>
    </a>
}

@if (Model.IsDeleted)
{
    <div class="alert alert--warning mb-5">
        <ui-icon name="warn" />
        <div class="alert__body">
            <p class="alert__title">This project is archived</p>
            <p class="alert__text">Saving keeps it off the public page. Use Restore in the list to publish it again.</p>
        </div>
    </div>
}

<section class="card">
    <div class="card__bd">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post"
              enctype="multipart/form-data" autocomplete="off" novalidate>
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-grid form-grid--2">
                <div class="field">
                    <label asp-for="Title" class="field__label"></label>
                    <input asp-for="Title" class="input" autocomplete="off" />
                    <span asp-validation-for="Title"></span>
                </div>

                <div class="field">
                    <label asp-for="ProjectURL" class="field__label"></label>
                    <input asp-for="ProjectURL" class="input" type="url" inputmode="url"
                           placeholder="https://…" autocomplete="off" />
                    <span asp-validation-for="ProjectURL"></span>
                </div>

                <div class="field form-grid__full">
                    <label asp-for="Description" class="field__label"></label>
                    <textarea asp-for="Description" class="textarea" rows="5"></textarea>
                    <span class="field__hint">Each line becomes a paragraph on the public page.</span>
                    <span asp-validation-for="Description"></span>
                </div>

                <div class="field">
                    <label asp-for="StartDate" class="field__label"></label>
                    <input asp-for="StartDate" class="input" type="date" />
                    <span asp-validation-for="StartDate"></span>
                </div>

                <div class="field">
                    <label asp-for="EndDate" class="field__label"></label>
                    <input asp-for="EndDate" class="input" type="date" />
                    <span asp-validation-for="EndDate"></span>
                </div>

                <div class="field form-grid__full">
                    <label asp-for="ProjectImage" class="field__label"></label>
                    @if (cover.Length > 0)
                    {
                        <img class="preview" src="@cover" alt="@($"{Model.Title} cover")" loading="lazy" decoding="async" />
                        <span class="field__hint">
                            Current file <span class="mono break-any">@Model.ExistingProjectImage</span> — a new upload replaces it.
                        </span>
                    }
                    else
                    {
                        <span class="field__hint">No cover saved yet, so the public card falls back to a folder glyph.</span>
                    }
                    <div class="file" data-preview="#projectPreview">
                        <input asp-for="ProjectImage" class="input" type="file" accept="image/*"
                               data-preview="#projectPreview" />
                    </div>
                    <img class="preview" id="projectPreview" alt="" hidden />
                    <span asp-validation-for="ProjectImage"></span>
                </div>
            </div>

            <div class="form-foot">
                <button class="btn btn--primary" type="submit">
                    <ui-icon name="save" size="sm" />
                    <span class="btn__label">Save changes</span>
                </button>
                <a class="btn btn--quiet" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    static string CoverSrc(string? file) => string.IsNullOrWhiteSpace(file)
        ? string.Empty
        : $"/Files/Images/Projects/{Uri.EscapeDataString(file.Trim())}";
}
